# ─── Site ───────────────────────────────────────────────────
PUBLIC_SITE_URL=https://nukhba.com
PUBLIC_WA_NUMBER=201112007555
PUBLIC_INSTAGRAM_URL=https://instagram.com/nukhba.eg
PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=your-cf-analytics-token

# ─── Admin (AI generator only) ──────────────────────────────
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_SESSION_SECRET=32-random-characters-here-change-me

# ─── GitHub OAuth (Decap CMS login) ─────────────────────────
# Create at github.com/settings/developers → OAuth Apps
# Authorization callback URL: https://nukhba-furniture.ammar-shata.workers.dev/api/callback
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret

# ─── Anthropic Claude API (AI product generator) ────────────
ANTHROPIC_API_KEY=sk-ant-api03-...
AI_MODEL=claude-sonnet-4-6

# ─── Cloudinary (product image uploads) ─────────────────────
# Create a free account at cloudinary.com
# Create an unsigned upload preset named "nukhba-products"
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_UPLOAD_PRESET=nukhba-products
