---
import type { CollectionEntry } from 'astro:content';
import ProductCard from './ProductCard.astro';

interface Props {
  products: CollectionEntry<'products'>[];
  lang?: 'en' | 'ar';
  showFilter?: boolean;
}

const { products, lang = 'en', showFilter = false } = Astro.props;
const isAr = lang === 'ar';

// Derive unique categories preserving first-seen order
const categories: string[] = [];
for (const p of products) {
  if (!categories.includes(p.data.category)) {
    categories.push(p.data.category);
  }
}

const allLabel = isAr ? 'الكل' : 'All';

const categoryLabelsAr: Record<string, string> = {
  'bedroom': 'غرفة نوم',
  'living-room': 'غرفة جلوس',
  'dining': 'غرفة طعام',
  'office': 'مكتب',
  'kids': 'أطفال',
  'outdoor': 'خارجي',
};

function formatCategory(cat: string, ar: boolean) {
  if (ar && categoryLabelsAr[cat]) return categoryLabelsAr[cat];
  return cat.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
}
---

<div dir={isAr ? 'rtl' : 'ltr'}>
  {showFilter && categories.length > 1 && (
    <div
      class="flex flex-wrap gap-2 mb-10"
      role="tablist"
      aria-label={isAr ? 'تصفية حسب الفئة' : 'Filter by category'}
      id="product-filter-tabs"
    >
      <button
        class="filter-tab active"
        data-filter="all"
        role="tab"
        aria-selected="true"
        aria-controls="product-grid"
      >
        {allLabel}
      </button>
      {categories.map(cat => (
        <button
          class="filter-tab"
          data-filter={cat}
          role="tab"
          aria-selected="false"
          aria-controls="product-grid"
        >
          {formatCategory(cat, isAr)}
        </button>
      ))}
    </div>
  )}

  <div
    id="product-grid"
    class="grid gap-6 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
    role="list"
  >
    {products.map((product, i) => (
      <div
        role="listitem"
        data-grid-item
        data-category={product.data.category}
        data-reveal
        style={`animation-delay:${(i % 4) * 0.07}s;`}
      >
        <ProductCard
          slug={product.data.slug}
          title={product.data.title}
          titleAr={product.data.titleAr}
          price={product.data.price}
          priceValue={product.data.priceValue}
          images={product.data.images}
          badge={product.data.badge}
          category={product.data.category}
          excerpt={product.data.excerpt}
          excerptAr={product.data.excerptAr}
          waText={product.data.waText}
          waTextAr={product.data.waTextAr}
          lang={lang}
        />
      </div>
    ))}
  </div>

  {products.length === 0 && (
    <div class="text-center py-24">
      <p style="color:var(--color-warm-gray); font-size:1.0625rem;">
        {isAr ? 'لا توجد منتجات متاحة حالياً.' : 'No products available at the moment.'}
      </p>
    </div>
  )}
</div>

<style>
  .filter-tab {
    padding: 0.5rem 1.25rem;
    border-radius: 9999px;
    border: 1.5px solid var(--color-beige-dark);
    background: transparent;
    color: var(--color-warm-gray);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(.16,1,.3,1);
    font-family: var(--font-sans);
  }
  .filter-tab:hover {
    border-color: var(--color-gold);
    color: var(--color-walnut);
  }
  .filter-tab.active {
    background: var(--color-walnut);
    color: var(--color-cream);
    border-color: var(--color-walnut);
  }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
  const items = document.querySelectorAll<HTMLElement>('[data-grid-item]');

  if (tabs.length > 0) {
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const filter = tab.dataset.filter ?? 'all';

        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        items.forEach(item => {
          const cat = item.dataset.category ?? '';
          const show = filter === 'all' || cat === filter;
          item.style.display = show ? '' : 'none';
        });
      });
    });
  }
</script>
