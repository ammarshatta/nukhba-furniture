---
import type { CollectionEntry } from 'astro:content';
import { useT } from '../../lib/i18n';

interface Props {
  slug: string;
  title: string;
  titleAr: string;
  price: string;
  priceValue: number;
  images: string[];
  badge?: string;
  category: string;
  excerpt: string;
  excerptAr: string;
  waText: string;
  waTextAr: string;
  lang?: 'en' | 'ar';
}

const {
  slug,
  title,
  titleAr,
  price,
  priceValue,
  images,
  badge,
  category,
  excerpt,
  excerptAr,
  waText,
  waTextAr,
  lang = 'en',
} = Astro.props;

const isAr = lang === 'ar';
const t = useT(lang);
const displayTitle = isAr ? titleAr : title;
const displayExcerpt = isAr ? excerptAr : excerpt;
// When no real price is set (priceValue === 0) show a localized "Price on Request"
// label instead of the raw Arabic string stored in the markdown.
const displayPrice = priceValue === 0 ? t.product.priceOnRequest : price;
const waMessage = isAr ? waTextAr : waText;
const waNumber = import.meta.env.PUBLIC_WA_NUMBER || '201040101056';
const waUrl = `https://wa.me/${waNumber}?text=${encodeURIComponent(waMessage)}`;
const productUrl = isAr ? `/products/${slug}` : `/en/products/${slug}`;

const badgeStyles: Record<string, string> = {
  new: 'background:var(--color-gold); color:var(--color-walnut-dark);',
  sale: 'background:#DC2626; color:#fff;',
  bestseller: 'background:var(--color-green); color:#fff;',
};

const badgeLabels: Record<string, { en: string; ar: string }> = {
  new: { en: 'NEW', ar: 'جديد' },
  sale: { en: 'SALE', ar: 'تخفيض' },
  bestseller: { en: 'BESTSELLER', ar: 'الأكثر مبيعاً' },
};

const activeBadge = badge && badge !== '' ? badge : null;
const badgeStyle = activeBadge ? badgeStyles[activeBadge] ?? 'background:var(--color-gold); color:var(--color-walnut-dark);' : '';
const badgeLabel = activeBadge
  ? (isAr ? badgeLabels[activeBadge]?.ar : badgeLabels[activeBadge]?.en) ?? activeBadge.toUpperCase()
  : '';

const viewLabel = isAr ? 'عرض التفاصيل' : 'View Details';
const waLabel = isAr ? 'واتساب' : 'WhatsApp';

const categoryLabelsAr: Record<string, string> = {
  'bedroom': 'غرفة نوم',
  'living-room': 'غرفة جلوس',
  'dining': 'غرفة طعام',
  'office': 'مكتب',
  'kids': 'أطفال',
  'outdoor': 'خارجي',
};
const categoryDisplay = isAr
  ? (categoryLabelsAr[category] ?? category.replace(/-/g, ' '))
  : category.replace(/-/g, ' ').toUpperCase();
---

<div
  class="card group"
  data-category={category}
>
  <!-- Image area — full link -->
  <a href={productUrl} class="block relative overflow-hidden" style="aspect-ratio:1/1;" aria-label={displayTitle}>
    {images[0] ? (
      <img
        src={images[0]}
        alt={displayTitle}
        loading="lazy"
        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
      />
    ) : (
      <div
        class="w-full h-full flex items-center justify-center"
        style="background:var(--color-beige-dark);"
      >
        <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" style="color:var(--color-warm-gray);" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="2"/>
          <circle cx="8.5" cy="8.5" r="1.5"/>
          <polyline points="21 15 16 10 5 21"/>
        </svg>
      </div>
    )}

    <!-- Badge chip -->
    {activeBadge && (
      <span
        class="absolute top-3 z-10 px-2.5 py-1 text-xs font-bold uppercase tracking-widest rounded-full"
        style={`${isAr ? 'right:0.75rem;' : 'left:0.75rem;'} ${badgeStyle}`}
      >
        {badgeLabel}
      </span>
    )}
  </a>

  <!-- Content -->
  <div class="p-5 flex flex-col gap-2">
    <!-- Category -->
    <p class="section-eyebrow" style="margin-bottom:0; font-size:0.65rem;">
      {categoryDisplay}
    </p>

    <!-- Title -->
    <a href={productUrl} class="block">
      <h3
        class="font-serif leading-snug truncate"
        style="font-size:1.05rem; font-weight:600; color:var(--color-walnut);"
        title={displayTitle}
      >
        {displayTitle}
      </h3>
    </a>

    <!-- Price -->
    <p
      class="font-semibold"
      style="color:var(--color-gold); font-size:1rem;"
    >
      {displayPrice}
    </p>

    <!-- Excerpt — 1 line clamp -->
    <p
      class="text-sm"
      style="color:var(--color-warm-gray); overflow:hidden; display:-webkit-box; -webkit-line-clamp:1; -webkit-box-orient:vertical; line-height:1.5;"
    >
      {displayExcerpt}
    </p>

    <!-- Actions row -->
    <div class="flex items-center gap-2 mt-1">
      <a
        href={productUrl}
        class="btn-outline flex-1 justify-center text-center"
        style="padding:0.5rem 0.875rem; font-size:0.72rem; color:var(--color-walnut); border-color:var(--color-walnut);"
      >
        {viewLabel}
      </a>

      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center rounded-lg flex-shrink-0 transition-colors duration-200 hover:opacity-90"
        style="width:38px; height:38px; background:var(--color-gold); color:var(--color-walnut-dark);"
        aria-label={waLabel}
        title={waLabel}
      >
        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
      </a>
    </div>
  </div>
</div>
