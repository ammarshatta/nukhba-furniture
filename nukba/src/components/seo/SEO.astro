---
import type { CollectionEntry } from 'astro:content';
import {
  buildOrganizationSchema,
  buildWebSiteSchema,
  buildFurnitureStoreSchema,
  buildProductSchema,
  buildArticleSchema,
  buildFAQSchema,
  buildBreadcrumbSchema,
} from '../../lib/seo';

interface Props {
  title: string;
  description: string;
  canonical: string;
  lang?: 'en' | 'ar';
  alternateUrl?: string;
  ogImage?: string;
  ogType?: 'website' | 'product' | 'article';
  product?: CollectionEntry<'products'>;
  article?: CollectionEntry<'blog'>;
  breadcrumbs?: Array<{ name: string; url: string }>;
  faqs?: Array<{ question: string; answer: string }>;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  lang = 'en',
  alternateUrl,
  ogImage,
  ogType = 'website',
  product,
  article,
  breadcrumbs,
  faqs,
  noindex = false,
} = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://shattafurniture.com';
// Global testing kill-switch: PUBLIC_NOINDEX=true → noindex the WHOLE site
// regardless of per-page setting. Flip to false (or remove) at launch.
const isNoindex = noindex || import.meta.env.PUBLIC_NOINDEX === 'true';
const siteName = 'Shatta Furniture — Luxury Furniture Egypt';
const fullTitle = (title.includes('Shatta') || title.includes('شطا')) ? title : `${title} | Shatta Furniture`;
const resolvedOgImage = ogImage
  ? (ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`)
  : `${siteUrl}/og-default.jpg`;
const locale = lang === 'ar' ? 'ar_EG' : 'en_US';
const altLocale = lang === 'ar' ? 'en_US' : 'ar_EG';

// hreflang requires ABSOLUTE URLs. Pages may pass alternateUrl as a relative
// path (e.g. "/en/products/x") — resolve it against siteUrl here.
const resolvedAlternate = alternateUrl
  ? (alternateUrl.startsWith('http') ? alternateUrl : `${siteUrl}${alternateUrl}`)
  : undefined;
// Arabic is the root/default; English lives under /en.
const arUrl = lang === 'ar' ? canonical : resolvedAlternate;
const enUrl = lang === 'ar' ? resolvedAlternate : canonical;

// Build JSON-LD array
const schemas: object[] = [buildOrganizationSchema()];
if (canonical === siteUrl || canonical === `${siteUrl}/`) {
  schemas.push(buildWebSiteSchema(), buildFurnitureStoreSchema());
}
if (product) schemas.push(buildProductSchema(product, lang));
if (article) schemas.push(buildArticleSchema(article));
if (breadcrumbs?.length) schemas.push(buildBreadcrumbSchema(breadcrumbs));
if (faqs?.length) schemas.push(buildFAQSchema(faqs));
---

<!-- Primary meta -->
<title>{fullTitle}</title>
<meta name="description" content={description} />
{isNoindex ? <meta name="robots" content="noindex,nofollow" /> : <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />}
<link rel="canonical" href={canonical} />

<!-- Language alternates (absolute URLs; x-default → Arabic root) -->
{resolvedAlternate && (
  <>
    <link rel="alternate" hreflang="ar" href={arUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={arUrl} />
  </>
)}

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={resolvedOgImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={locale} />
<meta property="og:locale:alternate" content={altLocale} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={resolvedOgImage} />

<!-- Extra SEO signals for AI discoverability -->
<meta name="keywords" content="luxury furniture Egypt, modern furniture Cairo, premium furniture, أثاث فاخر, أثاث مودرن, Shatta, شطا" />
<meta name="author" content="Shatta" />
<meta name="geo.region" content="EG" />
<meta name="geo.placename" content="Cairo, Egypt" />

<!-- JSON-LD Structured Data -->
{schemas.map(schema => (
  <script type="application/ld+json" set:html={JSON.stringify(schema, null, 2)} />
))}
