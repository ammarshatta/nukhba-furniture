---
interface Props {
  lang?: 'en' | 'ar';
}

const { lang = 'en' } = Astro.props;
const isAr = lang === 'ar';
const dir = isAr ? 'rtl' : 'ltr';

const igHandle = '@nukhba.eg';
const igUrl = 'https://www.instagram.com/nukhba.eg';

const eyebrow = isAr ? 'تابعنا' : 'Follow Us';
const heading = isAr ? 'تابع رحلتنا' : 'Follow Our Journey';
const subtitle = isAr
  ? `شاهد أحدث تصاميمنا وإلهام الديكور على إنستغرام ${igHandle}`
  : `See our latest designs and décor inspiration on Instagram ${igHandle}`;
const viewOnIG = isAr ? 'عرض على إنستغرام' : 'View on Instagram';

const galleryImages = [
  { src: '/images/gallery/gallery-1.jpg', alt: isAr ? 'أثاث نُخبة ١' : 'Nukhba Furniture 1' },
  { src: '/images/gallery/gallery-2.jpg', alt: isAr ? 'أثاث نُخبة ٢' : 'Nukhba Furniture 2' },
  { src: '/images/gallery/gallery-3.jpg', alt: isAr ? 'أثاث نُخبة ٣' : 'Nukhba Furniture 3' },
  { src: '/images/gallery/gallery-4.jpg', alt: isAr ? 'أثاث نُخبة ٤' : 'Nukhba Furniture 4' },
  { src: '/images/gallery/gallery-5.jpg', alt: isAr ? 'أثاث نُخبة ٥' : 'Nukhba Furniture 5' },
  { src: '/images/gallery/gallery-6.jpg', alt: isAr ? 'أثاث نُخبة ٦' : 'Nukhba Furniture 6' },
];
---

<section
  class="py-20 lg:py-28"
  dir={dir}
  style="background-color: var(--color-cream);"
  data-reveal
>
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <!-- Header -->
    <div class="text-center mb-12" data-reveal>
      <span class="section-eyebrow">{eyebrow}</span>
      <h2 class="section-title">{heading}</h2>
      <p class="section-subtitle" style="margin-inline: auto; text-align: center;">{subtitle}</p>
      <!-- Instagram handle link -->
      <a
        href={igUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 mt-4 text-sm font-semibold transition-opacity hover:opacity-70"
        style="color: var(--color-gold);"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
        </svg>
        {igHandle}
      </a>
    </div>

    <!-- 3×2 Image grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 lg:gap-4">
      {galleryImages.map((img, i) => (
        <a
          href={igUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="gallery-cell relative overflow-hidden rounded-xl group block"
          style="aspect-ratio: 1; box-shadow: var(--shadow-soft);"
          aria-label={`${viewOnIG} — ${img.alt}`}
          data-reveal
        >
          <!-- Image -->
          <img
            src={img.src}
            alt={img.alt}
            loading="lazy"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
          />

          <!-- Hover overlay -->
          <div
            class="absolute inset-0 flex flex-col items-center justify-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
            style="background: rgba(26,58,47,0.78);"
            aria-hidden="true"
          >
            <!-- Instagram SVG icon -->
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
            <span
              class="text-white text-xs font-semibold tracking-wide text-center px-3"
              style="letter-spacing: 0.08em;"
            >
              {viewOnIG}
            </span>
          </div>
        </a>
      ))}
    </div>

    <!-- Follow CTA -->
    <div class="text-center mt-10">
      <a
        href={igUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-outline inline-flex items-center gap-2"
        style="color: var(--color-walnut); border-color: var(--color-walnut);"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
        </svg>
        {isAr ? `تابعنا على ${igHandle}` : `Follow us on ${igHandle}`}
      </a>
    </div>
  </div>
</section>
