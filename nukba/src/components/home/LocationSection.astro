---
import type { CollectionEntry } from 'astro:content';

interface Props {
  locations: CollectionEntry<'locations'>[];
  lang?: 'en' | 'ar';
}

const { locations, lang = 'en' } = Astro.props;
const isAr = lang === 'ar';
const dir = isAr ? 'rtl' : 'ltr';

const eyebrow = isAr ? 'زورونا' : 'Visit Us';
const heading = isAr ? 'معارضنا' : 'Visit Our Showrooms';
const subtitle = isAr
  ? 'تجربة الفخامة بنفسك — فريقنا في انتظاركم'
  : 'Experience luxury in person — our team is ready to welcome you.';
const getDirections = isAr ? 'احصل على الاتجاهات' : 'Get Directions';
const callNow = isAr ? 'اتصل الآن' : 'Call Now';
const hoursLabel = isAr ? 'ساعات العمل' : 'Opening Hours';
const phoneLabel = isAr ? 'الهاتف' : 'Phone';
---

<section
  class="py-20 lg:py-28"
  dir={dir}
  style="background-color: var(--color-beige);"
  data-reveal
>
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <!-- Header -->
    <div class="text-center mb-14" data-reveal>
      <span class="section-eyebrow">{eyebrow}</span>
      <h2 class="section-title">{heading}</h2>
      <p class="section-subtitle" style="margin-inline: auto; text-align: center;">{subtitle}</p>
    </div>

    <!-- Locations grid -->
    <div class={`grid gap-8 ${locations.length === 1 ? 'grid-cols-1 max-w-2xl mx-auto' : 'grid-cols-1 lg:grid-cols-2'}`}>
      {locations.map((loc, i) => {
        const name = isAr ? loc.data.nameAr : loc.data.name;
        const city = isAr ? loc.data.cityAr : loc.data.city;
        const area = isAr ? loc.data.areaAr : loc.data.area;
        const address = isAr ? loc.data.addressAr : loc.data.address;
        const hours = isAr && loc.data.hoursAr ? loc.data.hoursAr : loc.data.hours;

        return (
          <div
            class="card overflow-hidden"
            data-reveal
            style={`animation-delay: ${i * 0.1}s;`}
          >
            <!-- Map embed -->
            {loc.data.mapEmbedSrc ? (
              <div class="w-full overflow-hidden" style="height: 300px;">
                <iframe
                  src={loc.data.mapEmbedSrc}
                  width="100%"
                  height="300"
                  style="border: 0; display: block;"
                  loading="lazy"
                  allowfullscreen
                  referrerpolicy="no-referrer-when-downgrade"
                  title={`${name} — ${isAr ? 'خريطة الموقع' : 'Location map'}`}
                ></iframe>
              </div>
            ) : (
              <!-- Placeholder map area -->
              <div
                class="w-full flex items-center justify-center"
                style="height: 300px; background: linear-gradient(135deg, var(--color-beige-dark), var(--color-beige)); position: relative; overflow: hidden;"
              >
                <div class="flex flex-col items-center gap-3 text-center px-6">
                  <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-warm-gray);" aria-hidden="true">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                    <circle cx="12" cy="10" r="3"/>
                  </svg>
                  <span class="text-sm font-medium" style="color: var(--color-warm-gray);">{name}</span>
                  <a
                    href={loc.data.googleMapsUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs font-semibold underline"
                    style="color: var(--color-gold);"
                  >
                    {getDirections}
                  </a>
                </div>
              </div>
            )}

            <!-- Location details -->
            <div class="p-7">
              <div class="flex items-start justify-between gap-4 mb-5">
                <div>
                  <h3
                    class="font-serif mb-1"
                    style="font-size: 1.2rem; font-weight: 600; color: var(--color-walnut);"
                  >
                    {name}
                  </h3>
                  <p class="text-sm" style="color: var(--color-warm-gray);">
                    {area}, {city}
                  </p>
                </div>
                <!-- Location pin icon -->
                <div
                  class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0"
                  style="background: rgba(196,164,74,0.1);"
                  aria-hidden="true"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-gold);">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                    <circle cx="12" cy="10" r="3"/>
                  </svg>
                </div>
              </div>

              <!-- Address -->
              <div class="flex gap-3 mb-4">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-gold); flex-shrink: 0; margin-top: 2px;" aria-hidden="true">
                  <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                  <polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
                <p class="text-sm" style="color: var(--color-matte); line-height: 1.6;">{address}</p>
              </div>

              <!-- Hours -->
              <div class="flex gap-3 mb-4">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-gold); flex-shrink: 0; margin-top: 2px;" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"/>
                  <polyline points="12 6 12 12 16 14"/>
                </svg>
                <div>
                  <div class="text-xs font-semibold uppercase tracking-wide mb-0.5" style="color: var(--color-warm-gray); letter-spacing: 0.1em;">{hoursLabel}</div>
                  <p class="text-sm" style="color: var(--color-matte);">{hours}</p>
                </div>
              </div>

              <!-- Phone -->
              <div class="flex gap-3 mb-7">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-gold); flex-shrink: 0; margin-top: 2px;" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.39 2 2 0 0 1 3.58 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.56a16 16 0 0 0 6.53 6.53l1.62-1.62a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
                <div>
                  <div class="text-xs font-semibold uppercase tracking-wide mb-0.5" style="color: var(--color-warm-gray); letter-spacing: 0.1em;">{phoneLabel}</div>
                  <a
                    href={`tel:${loc.data.phone}`}
                    class="text-sm font-medium transition-colors hover:opacity-70"
                    style="color: var(--color-walnut);"
                  >
                    {loc.data.phone}
                  </a>
                </div>
              </div>

              <!-- Actions -->
              <div class="flex gap-3">
                <a
                  href={loc.data.googleMapsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 btn-primary text-center justify-center"
                  style="padding: 0.65rem 1rem; font-size: 0.8rem;"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                    <circle cx="12" cy="10" r="3"/>
                  </svg>
                  {getDirections}
                </a>
                <a
                  href={`tel:${loc.data.phone}`}
                  class="btn-outline flex items-center gap-1.5"
                  style="color: var(--color-walnut); border-color: var(--color-walnut); padding: 0.625rem 1.25rem; font-size: 0.8rem;"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.39 2 2 0 0 1 3.58 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.56a16 16 0 0 0 6.53 6.53l1.62-1.62a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
                  </svg>
                  {callNow}
                </a>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
