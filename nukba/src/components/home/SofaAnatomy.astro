---
// Scroll-driven "anatomy of the sofa" intro.
// A pinned cross-section DIAGRAM (not a photo): four construction layers
// stacked top→bottom (fabric → foam → springs → frame). As the user scrolls
// DOWN, the highlight moves DOWN the stack — matching the vertical scroll —
// and the matching component text reveals. Pure CSS/JS, no libraries.
interface Props {
  lang?: 'en' | 'ar';
  productHref?: string;
  /** Hide the "Explore this sofa" CTA (e.g. when already on the product page). */
  showCta?: boolean;
}

const { lang = 'ar', productHref, showCta = true } = Astro.props;
const isAr = lang === 'ar';
const dir = isAr ? 'rtl' : 'ltr';
const href = productHref ?? (isAr ? '/products/cloud-boucle-sofa-set' : '/en/products/cloud-boucle-sofa-set');

const eyebrow = isAr ? 'من ورشتنا' : 'From Our Workshop';
const heading = isAr ? 'جودة تبدأ من الداخل' : 'Quality Starts on the Inside';
const subtitle = isAr
  ? 'مرّر لأسفل لتكتشف مكوّنات كنب شطا — من القماش الذي تلمسه إلى الهيكل الذي يدوم.'
  : 'Scroll down to explore what builds a Shatta sofa — from the fabric you touch to the frame that lasts.';
const ctaLabel = isAr ? 'اكتشف هذه الكنبة' : 'Explore This Sofa';

// Top → bottom order = scroll order.
const steps = [
  {
    n: '01', key: 'fabric',
    ar: { t: 'أفضل الأقمشة', d: 'أقمشة بوكليه ومخمل مختارة بعناية: ناعمة الملمس، متينة، ومقاومة للاستخدام اليومي والبهتان.' },
    en: { t: 'Premium Fabrics', d: 'Carefully selected bouclé and velvet fabrics: soft to the touch, durable, and resistant to daily wear and fading.' },
  },
  {
    n: '02', key: 'foam',
    ar: { t: 'إسفنج عالي الكثافة', d: 'حشوة إسفنج عالي الكثافة تحافظ على شكلها وراحتها سنوات طويلة، فلا تفقد الكنبة امتلاءها.' },
    en: { t: 'High-Density Foam', d: 'High-density foam padding keeps its shape and comfort for years, so the sofa never goes flat.' },
  },
  {
    n: '03', key: 'springs',
    ar: { t: 'سوست زجزاج (No-Sag)', d: 'نظام سوست زجزاج يوزّع وزن الجلوس بالتساوي ويمنح دعماً مرناً ثابتاً لا «يغطس» مع الوقت.' },
    en: { t: 'Zigzag No-Sag Springs', d: 'A zigzag spring system distributes weight evenly and gives firm, lasting support that never sags.' },
  },
  {
    n: '04', key: 'frame',
    ar: { t: 'هيكل خشب الزان الأحمر', d: 'هيكل من خشب الزان الأحمر المجفّف يدوياً — يتحمّل سنوات من الاستخدام دون اعوجاج أو ارتخاء في الوصلات.' },
    en: { t: 'Red Beech Wood Frame', d: 'A hand-dried red beech frame that endures years of daily use without warping or loosening at the joints.' },
  },
];
---

<section id="sofa-anatomy" class="anatomy" dir={dir} aria-label={heading}>
  <div class="anatomy-track">
    <div class="anatomy-stage">
      <div class="anatomy-grid">
        <!-- Cross-section diagram -->
        <div class="anatomy-diagram" aria-hidden="true">
          <!-- little sofa hint above the stack -->
          <svg class="sofa-hint" viewBox="0 0 120 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 38 v-12 a8 8 0 0 1 8 -8 h76 a8 8 0 0 1 8 8 v12" />
            <path d="M8 38 v-8 a6 6 0 0 1 12 0 v6" />
            <path d="M112 38 v-8 a6 6 0 0 0 -12 0 v6" />
            <path d="M20 30 h80" />
            <path d="M10 42 v4 M110 42 v4" />
          </svg>

          <div class="layer-stack">
            {steps.map((s, i) => {
              const c = isAr ? s.ar : s.en;
              return (
                <div class:list={['layer', `layer--${s.key}`, { 'is-active': i === 0 }]} data-step={i}>
                  <span class="layer-tex"></span>
                  {s.key === 'springs' && (
                    <svg class="layer-zig" viewBox="0 0 200 24" preserveAspectRatio="none" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M0 12 L12 3 L24 21 L36 3 L48 21 L60 3 L72 21 L84 3 L96 21 L108 3 L120 21 L132 3 L144 21 L156 3 L168 21 L180 3 L192 21 L200 12" />
                    </svg>
                  )}
                  <span class="layer-tag"><b>{s.n}</b> {c.t}</span>
                </div>
              );
            })}
          </div>
        </div>

        <!-- Text side -->
        <div class="anatomy-info">
          <span class="section-eyebrow" style="color:var(--color-gold);">{eyebrow}</span>
          <h2 class="anatomy-heading">{heading}</h2>
          <p class="anatomy-sub">{subtitle}</p>

          <div class="anatomy-body">
            <!-- vertical step rail (matches vertical scroll) -->
            <div class="anatomy-rail">
              {steps.map((s, i) => (
                <button
                  type="button"
                  class:list={['rail-node', { 'is-active': i === 0 }]}
                  data-step={i}
                  aria-label={`${isAr ? 'انتقل إلى' : 'Go to'} ${(isAr ? s.ar : s.en).t}`}
                >{s.n}</button>
              ))}
            </div>

            <div class="anatomy-panels">
              {steps.map((s, i) => {
                const c = isAr ? s.ar : s.en;
                return (
                  <article class:list={['anatomy-panel', { 'is-active': i === 0 }]} data-step={i}>
                    <h3>{c.t}</h3>
                    <p>{c.d}</p>
                  </article>
                );
              })}
            </div>
          </div>

          {showCta && <a href={href} class="btn-primary anatomy-cta">{ctaLabel}</a>}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .anatomy { background: var(--color-walnut); color: var(--color-cream); }
  .anatomy-track { position: relative; height: 280vh; }
  .anatomy-stage {
    position: sticky; top: 0; height: 100vh;
    display: flex; align-items: center; overflow: hidden;
  }
  .anatomy-grid {
    max-width: 80rem; margin: 0 auto; padding: 2rem 1.5rem; width: 100%;
    display: grid; grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 5vw, 4rem); align-items: center;
  }

  /* ── Cross-section diagram ── */
  .anatomy-diagram { display: flex; flex-direction: column; align-items: center; gap: 1rem; }
  .sofa-hint { width: 130px; height: auto; color: rgba(196,164,74,.6); }
  .layer-stack {
    width: 100%; max-width: 380px;
    display: flex; flex-direction: column; gap: 12px;
  }
  .layer {
    position: relative; overflow: hidden;
    height: clamp(56px, 9vh, 82px);
    border-radius: 14px;
    border: 1.5px solid transparent;
    display: flex; align-items: center;
    padding: 0 1rem;
    opacity: .4; transform: scale(.97);
    cursor: pointer;
    animation: layer-in .6s cubic-bezier(.16,1,.3,1) both;
    transition: opacity .5s cubic-bezier(.16,1,.3,1), transform .5s cubic-bezier(.16,1,.3,1), box-shadow .5s;
  }
  .layer:nth-child(1) { animation-delay: .05s; }
  .layer:nth-child(2) { animation-delay: .13s; }
  .layer:nth-child(3) { animation-delay: .21s; }
  .layer:nth-child(4) { animation-delay: .29s; }
  @keyframes layer-in { from { opacity: 0; transform: translateY(18px) scale(.95); } }
  .layer:hover { opacity: .8; }
  .layer.is-active {
    opacity: 1; transform: scale(1.03);
    border-color: var(--color-gold);
    box-shadow: 0 14px 36px rgba(0,0,0,.4);
  }
  /* shine sweep when a layer becomes active */
  .layer.is-active::after {
    content: ''; position: absolute; inset: 0; z-index: 3; pointer-events: none;
    background: linear-gradient(110deg, transparent 30%, rgba(255,255,255,.35) 50%, transparent 70%);
    transform: translateX(-120%);
    animation: shine 1.1s ease-out .1s 1;
  }
  @keyframes shine { to { transform: translateX(120%); } }
  .layer-tex { position: absolute; inset: 0; }
  .layer-tag {
    position: relative; z-index: 2;
    font-family: var(--font-serif); font-weight: 600;
    font-size: clamp(.85rem, 2.4vw, 1.05rem);
    color: #fff; text-shadow: 0 1px 4px rgba(0,0,0,.45);
    display: flex; align-items: center; gap: .55rem;
  }
  .layer-tag b {
    font-size: .72rem; font-weight: 700; font-style: normal;
    background: var(--color-gold); color: var(--color-walnut);
    width: 24px; height: 24px; border-radius: 50%;
    display: grid; place-items: center; flex-shrink: 0;
  }

  /* layer textures */
  .layer--fabric .layer-tex {
    background:
      repeating-linear-gradient(45deg, rgba(255,255,255,.10) 0 3px, transparent 3px 6px),
      linear-gradient(135deg, #b79b86, #9c7f6a);
  }
  .layer--foam .layer-tex {
    background:
      radial-gradient(circle at 20% 40%, rgba(255,255,255,.5) 0 4px, transparent 5px),
      radial-gradient(circle at 60% 70%, rgba(255,255,255,.4) 0 5px, transparent 6px),
      radial-gradient(circle at 85% 30%, rgba(255,255,255,.45) 0 4px, transparent 5px),
      linear-gradient(135deg, #e7e0d2, #cfc4ad);
  }
  .layer--springs .layer-tex { background: linear-gradient(135deg, #8f8a7d, #6f6a5d); }
  .layer--springs .layer-zig {
    position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1;
    color: rgba(255,255,255,.55);
  }
  .layer--springs .layer-zig path {
    stroke-dasharray: 640; stroke-dashoffset: 0;
  }
  .layer--springs.is-active .layer-zig path {
    animation: draw-zig 1.1s ease-out .1s both;
  }
  @keyframes draw-zig { from { stroke-dashoffset: 640; } to { stroke-dashoffset: 0; } }
  .layer--frame .layer-tex {
    background:
      repeating-linear-gradient(90deg, rgba(0,0,0,.12) 0 2px, transparent 2px 22px),
      linear-gradient(135deg, #9a6a44, #6f4a2e);
  }

  /* ── Info side ── */
  .anatomy-heading {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    font-weight: 700; line-height: 1.15; margin: .5rem 0 .65rem; color: #fff;
  }
  .anatomy-sub { color: rgba(250,250,247,.6); font-size: 1rem; margin-bottom: 1.75rem; max-width: 36ch; }

  .anatomy-body { display: flex; gap: 1.25rem; align-items: stretch; }

  /* vertical step rail */
  .anatomy-rail {
    position: relative; flex-shrink: 0;
    display: flex; flex-direction: column; justify-content: space-between;
    padding: .25rem 0;
  }
  .anatomy-rail::before {
    content: ''; position: absolute; top: 12px; bottom: 12px;
    inset-inline-start: 13px; width: 2px; background: rgba(250,250,247,.18);
  }
  .rail-node {
    position: relative; z-index: 1;
    width: 28px; height: 28px; border-radius: 50%;
    display: grid; place-items: center;
    font-size: .72rem; font-weight: 700; font-family: inherit;
    padding: 0; cursor: pointer; appearance: none;
    background: var(--color-walnut);
    border: 2px solid rgba(250,250,247,.25);
    color: rgba(250,250,247,.5);
    transition: all .4s cubic-bezier(.16,1,.3,1);
  }
  .rail-node:hover { border-color: var(--color-gold); color: #fff; }
  .rail-node:focus-visible { outline: 2px solid var(--color-gold); outline-offset: 3px; }
  .rail-node.is-active {
    background: var(--color-gold); border-color: var(--color-gold);
    color: var(--color-walnut); transform: scale(1.12);
  }
  .rail-node.is-active::after {
    content: ''; position: absolute; inset: -2px; border-radius: 50%;
    border: 2px solid var(--color-gold);
    animation: rail-pulse 1.8s ease-out infinite;
  }
  @keyframes rail-pulse {
    0% { transform: scale(1); opacity: .7; }
    100% { transform: scale(1.9); opacity: 0; }
  }

  .anatomy-panels { position: relative; flex: 1; min-height: 150px; }
  .anatomy-panel {
    position: absolute; inset: 0;
    opacity: 0; transform: translateY(22px);
    transition: opacity .55s cubic-bezier(.16,1,.3,1), transform .55s cubic-bezier(.16,1,.3,1);
    pointer-events: none;
  }
  .anatomy-panel.is-active { opacity: 1; transform: none; pointer-events: auto; }
  .anatomy-panel h3 {
    font-family: var(--font-serif); font-size: 1.5rem; font-weight: 600;
    color: var(--color-gold); margin: 0 0 .6rem;
  }
  .anatomy-panel p {
    color: rgba(250,250,247,.78); font-size: 1.05rem; line-height: 1.8; max-width: 42ch;
  }

  .anatomy-cta { padding: .75rem 1.75rem; font-size: .85rem; margin-top: 1.75rem; }

  @media (max-width: 900px) {
    .anatomy-grid { grid-template-columns: 1fr; gap: 1.75rem; }
    .anatomy-sub { display: none; }
    .layer-stack { max-width: 100%; }
  }

  /* Reduced motion / no-JS: show everything stacked, no pinning */
  @media (prefers-reduced-motion: reduce) {
    .anatomy-track { height: auto; }
    .anatomy-stage { position: static; height: auto; padding: 4rem 0; }
    .layer { opacity: 1; transform: none; }
    .anatomy-panels { position: static; min-height: 0; }
    .anatomy-panel { position: static; opacity: 1; transform: none; margin-bottom: 1.25rem; }
  }
</style>

<script>
  const section = document.getElementById('sofa-anatomy');
  if (section && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const track = section.querySelector('.anatomy-track') as HTMLElement | null;
    const groups = [
      Array.from(section.querySelectorAll('.layer')),
      Array.from(section.querySelectorAll('.anatomy-panel')),
      Array.from(section.querySelectorAll('.rail-node')),
    ];
    const steps = groups[1].length;
    let ticking = false;
    let current = -1;

    function setActive(i: number) {
      if (i === current) return;
      current = i;
      groups.forEach(g => g.forEach((el, n) => el.classList.toggle('is-active', n === i)));
    }
    function update() {
      ticking = false;
      if (!track) return;
      const rect = track.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const p = total > 0 ? Math.min(Math.max(-rect.top / total, 0), 1) : 0;
      let active = Math.floor(p * steps);
      if (active > steps - 1) active = steps - 1;
      if (active < 0) active = 0;
      setActive(active);
    }
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();

    // Click a layer or rail node → smooth-scroll to that step.
    function goToStep(i: number) {
      if (!track) return;
      const rect = track.getBoundingClientRect();
      const start = rect.top + window.scrollY;
      const total = rect.height - window.innerHeight;
      const ratio = Math.min(Math.max((i + 0.5) / steps, 0), 1);
      window.scrollTo({ top: start + ratio * total, behavior: 'smooth' });
    }
    const clickable = [
      ...section.querySelectorAll('.rail-node'),
      ...section.querySelectorAll('.layer'),
    ];
    clickable.forEach(el => {
      el.addEventListener('click', () => {
        const i = Number((el as HTMLElement).dataset.step);
        if (!Number.isNaN(i)) goToStep(i);
      });
    });
  }
</script>
