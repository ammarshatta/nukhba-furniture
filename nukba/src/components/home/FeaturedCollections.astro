---
import type { CollectionEntry } from 'astro:content';

interface Props {
  categories: CollectionEntry<'categories'>[];
  lang?: 'en' | 'ar';
}

const { categories, lang = 'en' } = Astro.props;
const isAr = lang === 'ar';
const dir = isAr ? 'rtl' : 'ltr';

const eyebrow = isAr ? 'تصفح' : 'Browse';
const heading = isAr ? 'مجموعاتنا' : 'Our Collections';
const subtitle = isAr
  ? 'من غرف النوم إلى المكاتب — كل مجموعة مصممة لتعكس أرقى أذواقكم'
  : 'From bedrooms to offices — every collection designed to reflect your finest taste.';
const viewLabel = isAr ? 'استعرض المجموعة' : 'View Collection';

const sorted = [...categories].sort((a, b) => a.data.order - b.data.order).slice(0, 6);
---

<section
  class="py-20 lg:py-28"
  dir={dir}
  style="background-color: var(--color-cream);"
  data-reveal
>
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <!-- Header -->
    <div class="text-center mb-14" data-reveal>
      <span class="section-eyebrow">{eyebrow}</span>
      <h2 class="section-title" style="color: var(--color-walnut);">{heading}</h2>
      <p class="section-subtitle mx-auto text-center" style="margin-inline: auto;">{subtitle}</p>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {sorted.map((category, i) => {
        const name = isAr ? category.data.nameAr : category.data.name;
        const desc = isAr ? category.data.descriptionAr : category.data.description;
        const href = isAr ? `/ar/collections/${category.data.slug}` : `/collections/${category.data.slug}`;
        return (
          <a
            href={href}
            class="collection-card group relative block overflow-hidden rounded-2xl"
            style="min-height: 380px; box-shadow: var(--shadow-card);"
            data-reveal
            style={`animation-delay: ${i * 0.08}s; min-height: 380px; box-shadow: var(--shadow-card);`}
            aria-label={name}
          >
            <!-- Background image -->
            <div
              class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-105"
              style={`background-image: url('${category.data.image}'), linear-gradient(135deg, var(--color-walnut-dark), var(--color-green-dark));`}
              aria-hidden="true"
            ></div>

            <!-- Gradient overlay -->
            <div
              class="absolute inset-0 transition-opacity duration-500 group-hover:opacity-80"
              style="background: linear-gradient(180deg, rgba(42,26,16,0.18) 0%, rgba(42,26,16,0.72) 60%, rgba(42,26,16,0.92) 100%);"
              aria-hidden="true"
            ></div>

            <!-- Content -->
            <div class="relative z-10 h-full flex flex-col justify-end p-7" style="min-height: 380px;">
              <h3
                class="font-serif text-white mb-2"
                style="font-size: clamp(1.4rem, 2.5vw, 1.9rem); font-weight: 600; line-height: 1.2;"
              >
                {name}
              </h3>
              <p
                class="text-sm mb-5 line-clamp-2"
                style="color: rgba(255,255,255,0.72); line-height: 1.65;"
              >
                {desc}
              </p>
              <span
                class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest transition-colors duration-300 group-hover:text-white"
                style="color: var(--color-gold); letter-spacing: 0.14em;"
              >
                {viewLabel}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {isAr
                    ? <polyline points="15 18 9 12 15 6"></polyline>
                    : <polyline points="9 18 15 12 9 6"></polyline>
                  }
                </svg>
              </span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .collection-card {
    cursor: pointer;
    text-decoration: none;
  }
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
