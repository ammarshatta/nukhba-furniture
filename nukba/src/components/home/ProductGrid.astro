---
import type { Lang } from '../../lib/i18n';
import { useT } from '../../lib/i18n';
import type { Product, Category } from '../../types';
import ProductCard from '../product/ProductCard.astro';

interface Props {
  lang: Lang;
  products: Product[];
  categories: Category[];
  globalWaNumber: string;
  refToken?: string;
  initialFilter?: string;
}

const { lang, products, categories, globalWaNumber, refToken, initialFilter } = Astro.props;
const t = useT(lang);
const s = t.sections;
const activeProducts = products.filter(p => p.active);
---

<section id="products" style="padding:var(--sec-pad);background:var(--white);">
  <div class="prod-head" data-r>
    <div class="s-eyebrow">{s.productsEyebrow}</div>
    <h2 class="s-heading">{s.productsTitle}</h2>
    <p class="s-sub">{s.productsSub}</p>

    <div class="filter-row" id="filterRow">
      <button class="filt-btn on" data-filter="all">
        {lang === 'ar' ? 'الكل' : 'All'}
      </button>
      {categories.map(cat => (
        <button class="filt-btn" data-filter={cat.slug}>
          {lang === 'ar' ? cat.nameAr : cat.nameEn}
        </button>
      ))}
    </div>
  </div>

  <div class="pgrid" id="productGrid">
    {activeProducts.map(product => (
      <ProductCard
        product={product}
        lang={lang}
        globalWaNumber={globalWaNumber}
        refToken={refToken}
      />
    ))}
  </div>

  {activeProducts.length === 0 && (
    <p style="text-align:center;color:var(--muted);padding:40px 0;">
      {lang === 'ar' ? 'لا توجد منتجات بعد' : 'No products yet'}
    </p>
  )}
</section>

<script>
  function filt(cat: string) {
    document.querySelectorAll('.filt-btn').forEach(b => {
      (b as HTMLElement).classList.toggle('on', (b as HTMLElement).dataset.filter === cat);
    });
    document.querySelectorAll('.pcard').forEach(card => {
      const el = card as HTMLElement;
      const matches = cat === 'all' || el.dataset.cat === cat;
      el.hidden = !matches;
    });
  }

  document.querySelectorAll('.filt-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      filt((btn as HTMLElement).dataset.filter ?? 'all');
    });
  });
</script>
