---
import { localizeUrl } from '../../lib/i18n';

interface Props {
  lang?: 'en' | 'ar';
}

const { lang = 'en' } = Astro.props;
const isAr = lang === 'ar';
const dir = isAr ? 'rtl' : 'ltr';

const waNumber = import.meta.env.PUBLIC_WA_NUMBER || '201112007555';
const waUrl = `https://wa.me/${waNumber}?text=${encodeURIComponent(isAr ? 'مرحباً، أريد الاستفسار عن أثاثكم الفاخر' : 'Hello, I would like to inquire about your luxury furniture')}`;

const content = {
  eyebrow: isAr ? 'أثاث فاخر مصر' : 'Luxury Furniture Egypt',
  h1a: isAr ? 'شطا' : 'Shatta',
  h1b: isAr ? 'حيث يسكن الفخامة' : 'Where Luxury Lives',
  subtitle: isAr
    ? 'أثاث فاخر مودرن مصنوع بعناية للمنازل المصرية. اكتشف التصاميم الخالدة.'
    : 'Premium modern furniture handcrafted for Egyptian homes. Explore timeless collections.',
  cta1: isAr ? 'استكشف المجموعات' : 'Explore Collections',
  cta2: isAr ? 'تواصل عبر واتساب' : 'WhatsApp Us',
  cta1Href: localizeUrl('/collections', lang),
};
---

<section
  class="relative min-h-screen flex items-center justify-center overflow-hidden"
  dir={dir}
  aria-label={isAr ? 'القسم الرئيسي' : 'Hero section'}
  style="background-image: url('https://images.unsplash.com/photo-1618219944342-824e40a13285?w=1600&q=80&fm=webp&fit=crop'), linear-gradient(135deg, var(--color-walnut-dark) 0%, var(--color-green-dark) 100%); background-size: cover; background-position: center; background-repeat: no-repeat;"
>
  <!-- Dark gradient overlay -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: linear-gradient(135deg, rgba(42,26,16,0.82) 0%, rgba(15,42,32,0.75) 60%, rgba(42,26,16,0.65) 100%);"
    aria-hidden="true"
  ></div>

  <!-- Gold horizontal accent line -->
  <div
    class="absolute left-0 right-0 pointer-events-none"
    style="top: 72px; height: 1px; background: linear-gradient(90deg, transparent 0%, var(--color-gold) 30%, var(--color-gold-light) 50%, var(--color-gold) 70%, transparent 100%); opacity: 0.45;"
    aria-hidden="true"
  ></div>

  <!-- Content -->
  <div class="relative z-10 w-full max-w-7xl mx-auto px-6 lg:px-12 py-24 flex flex-col items-center text-center">
    <div data-reveal>
      <!-- Eyebrow -->
      <span
        class="inline-block mb-5 text-xs font-semibold tracking-widest uppercase"
        style="color: var(--color-gold); letter-spacing: 0.22em;"
      >
        {content.eyebrow}
      </span>

      <!-- H1 -->
      <h1
        class="font-serif mb-6"
        style="font-family: var(--font-serif); font-size: clamp(2.75rem, 7vw, 5.5rem); font-weight: 700; line-height: 1.08; letter-spacing: -0.02em; color: #fff;"
      >
        <span style="color: var(--color-gold-light);">{content.h1a}</span>
        <span style="display: block; font-weight: 400; font-size: clamp(1.5rem, 4vw, 3rem); color: rgba(255,255,255,0.92); margin-top: 0.25em;">
          {isAr ? '—' : '—'} {content.h1b}
        </span>
      </h1>

      <!-- Subtitle -->
      <p
        class="mx-auto mb-10 text-lg"
        style="max-width: 560px; color: rgba(255,255,255,0.78); line-height: 1.75; font-size: clamp(1rem, 2vw, 1.125rem);"
      >
        {content.subtitle}
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap items-center justify-center gap-4 mb-6">
        <a href={content.cta1Href} class="btn-gold" style="font-size:0.875rem; padding:0.9rem 2.25rem;">
          {content.cta1}
        </a>
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline"
          style="color:#fff; border-color:rgba(255,255,255,0.6); font-size:0.875rem; padding:0.875rem 2rem;"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="flex-shrink:0;">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          {content.cta2}
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div
    class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2"
    style="color: var(--color-gold); opacity: 0.8;"
    aria-hidden="true"
  >
    <span class="text-xs font-medium tracking-widest uppercase" style="font-size:0.65rem; letter-spacing:0.18em; color:rgba(255,255,255,0.5);">
      {isAr ? 'اكتشف' : 'Scroll'}
    </span>
    <svg
      width="22"
      height="22"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="hero-scroll-chevron"
    >
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </div>
</section>

<style>
  .hero-scroll-chevron {
    animation: bounceDown 1.8s ease-in-out infinite;
  }
  @keyframes bounceDown {
    0%, 100% { transform: translateY(0); opacity: 0.8; }
    50% { transform: translateY(6px); opacity: 1; }
  }
</style>
