---
import type { CollectionEntry } from 'astro:content';

interface Props {
  products: CollectionEntry<'products'>[];
  lang?: 'en' | 'ar';
}

const { products, lang = 'en' } = Astro.props;
const isAr = lang === 'ar';
const dir = isAr ? 'rtl' : 'ltr';

const waNumber = import.meta.env.PUBLIC_WA_NUMBER || '201040101056';

const eyebrow = isAr ? 'الأكثر طلباً' : 'Top Picks';
const heading = isAr ? 'الأكثر مبيعاً' : 'Best Sellers';
const subtitle = isAr
  ? 'أكثر قطعنا إقبالاً من عملائنا — جودة لا تُضاهى وتصاميم تدوم'
  : 'Our most-loved pieces — unmatched quality and designs that endure.';
const viewDetails = isAr ? 'عرض التفاصيل' : 'View Details';
const waLabel = isAr ? 'استفسر' : 'Enquire';

const badgeLabels: Record<string, { en: string; ar: string }> = {
  bestseller: { en: 'BESTSELLER', ar: 'الأكثر مبيعاً' },
  new: { en: 'NEW', ar: 'جديد' },
  sale: { en: 'SALE', ar: 'تخفيض' },
};

const featured = products.filter(p => p.data.active).slice(0, 8);
---

<section
  class="py-20 lg:py-28"
  dir={dir}
  style="background-color: var(--color-beige);"
  data-reveal
>
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <!-- Header -->
    <div class="text-center mb-12" data-reveal>
      <span class="section-eyebrow">{eyebrow}</span>
      <h2 class="section-title">{heading}</h2>
      <p class="section-subtitle" style="margin-inline: auto; text-align: center;">{subtitle}</p>
    </div>

    <!-- Horizontal scroll on mobile, grid on desktop -->
    <div
      class="products-scroll-container"
    >
      {featured.map((product, i) => {
        const name = isAr ? product.data.titleAr : product.data.title;
        const href = isAr ? `/products/${product.data.slug}` : `/en/products/${product.data.slug}`;
        const image = product.data.images?.[0];
        const badge = product.data.badge && product.data.badge !== '' ? product.data.badge : null;
        const badgeText = badge ? (isAr ? badgeLabels[badge]?.ar : badgeLabels[badge]?.en) ?? badge.toUpperCase() : null;
        const waMessage = isAr
          ? `مرحباً، أريد الاستفسار عن: ${product.data.titleAr}`
          : `Hello, I'd like to enquire about: ${product.data.title}`;
        const waUrl = `https://wa.me/${waNumber}?text=${encodeURIComponent(waMessage)}`;

        return (
          <div class="card product-card flex-shrink-0" data-reveal style={`animation-delay: ${i * 0.06}s;`}>
            <!-- Image -->
            <div class="relative overflow-hidden" style="aspect-ratio: 4/3;">
              {image ? (
                <img
                  src={image}
                  alt={name}
                  loading="lazy"
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                />
              ) : (
                <div
                  class="w-full h-full flex items-center justify-center"
                  style="background: var(--color-beige-dark);"
                >
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" style="color: var(--color-warm-gray);" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="2"/>
                    <circle cx="8.5" cy="8.5" r="1.5"/>
                    <polyline points="21 15 16 10 5 21"/>
                  </svg>
                </div>
              )}
              {badgeText && (
                <span
                  class="absolute top-3 z-10 px-2.5 py-1 text-xs font-bold uppercase tracking-wide rounded-full"
                  style={`${isAr ? 'right: 0.75rem;' : 'left: 0.75rem;'} background: var(--color-gold); color: var(--color-walnut-dark); letter-spacing: 0.08em;`}
                >
                  {badgeText}
                </span>
              )}
            </div>

            <!-- Info -->
            <div class="p-5">
              <h3
                class="font-serif mb-1 leading-snug"
                style="font-size: 1.05rem; font-weight: 600; color: var(--color-walnut);"
              >
                {name}
              </h3>
              <p
                class="text-sm mb-4"
                style="color: var(--color-gold); font-weight: 600; font-size: 1rem;"
              >
                {product.data.price}
              </p>

              <!-- Actions -->
              <div class="flex items-center gap-2">
                <a
                  href={href}
                  class="flex-1 btn-primary text-center justify-center"
                  style="padding: 0.6rem 1rem; font-size: 0.75rem;"
                >
                  {viewDetails}
                </a>
                <a
                  href={waUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center justify-center rounded-lg transition-colors duration-200"
                  style="width: 38px; height: 38px; background: var(--color-green); color: #fff; flex-shrink: 0;"
                  aria-label={waLabel}
                  title={waLabel}
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .products-scroll-container {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 1024px) {
    .products-scroll-container {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .products-scroll-container {
      display: flex;
      overflow-x: auto;
      gap: 1rem;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 1rem;
    }
    .product-card {
      width: 72vw;
      min-width: 260px;
      scroll-snap-align: start;
    }
    .products-scroll-container::-webkit-scrollbar {
      height: 4px;
    }
    .products-scroll-container::-webkit-scrollbar-track {
      background: var(--color-beige-dark);
      border-radius: 2px;
    }
    .products-scroll-container::-webkit-scrollbar-thumb {
      background: var(--color-gold);
      border-radius: 2px;
    }
  }
</style>
