---
interface Props {
  lang?: 'en' | 'ar';
}

const { lang = 'en' } = Astro.props;
const isAr = lang === 'ar';
const dir = isAr ? 'rtl' : 'ltr';

const content = isAr
  ? {
      eyebrow: 'قصتنا',
      heading: 'العلامة التجارية الأولى للأثاث الفاخر في مصر',
      para1: 'تأسست شطا من شغف بالتميز، لتجلب الحرفية الأوروبية إلى المنازل المصرية. كل قطعة يتم اختيارها لجودتها وجمالها وديمومتها — أثاث يصبح جزءاً من قصة عائلتك.',
      para2: 'نحصل على أفضل الخامات من حول العالم — خشب البلوط الصلب من أوروبا، المخمل من إيطاليا، والمعادن المشطوبة يدوياً — مدمجةً مع الحرفية المصرية المتقنة لإنتاج قطع تُعرِّف الأماكن.',
      stat1Label: 'تصميم فريد',
      stat1Val: '+٥٠٠',
      stat2Label: 'سنة من الخبرة',
      stat2Val: '+١٥',
      stat3Label: 'منزل سعيد',
      stat3Val: '+١٠٬٠٠٠',
      cta: 'اكتشف قصتنا',
      imgAlt: 'صالة عرض شطا',
    }
  : {
      eyebrow: 'Our Story',
      heading: "Egypt's Premier Luxury Furniture Brand",
      para1: 'Founded on a passion for excellence, Shatta brings European craftsmanship to Egyptian homes. Every piece is selected for its quality, beauty, and longevity — furniture that becomes part of your family\'s story.',
      para2: 'We source premium materials from around the world — solid oak from Europe, velvet from Italy, hand-finished metals — combined with Egyptian master craftsmanship to create pieces that define spaces.',
      stat1Label: 'Unique Designs',
      stat1Val: '500+',
      stat2Label: 'Years of Excellence',
      stat2Val: '15+',
      stat3Label: 'Homes Furnished',
      stat3Val: '10,000+',
      cta: 'Discover Our Story',
      imgAlt: 'Shatta Showroom',
    };

const ctaHref = isAr ? '/ar/about' : '/about';
---

<section
  class="py-20 lg:py-28"
  dir={dir}
  style="background-color: var(--color-beige);"
>
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

      <!-- Left: Styled image frame -->
      <div class="about-image-container relative" data-reveal>
        <!-- Outer gold border accent -->
        <div
          class="absolute rounded-2xl pointer-events-none"
          style={`top: 1.5rem; ${isAr ? 'left: -1.5rem;' : 'right: -1.5rem;'} bottom: -1.5rem; border: 2px solid var(--color-gold); border-radius: 1rem; opacity: 0.45; z-index: 0;`}
          aria-hidden="true"
        ></div>

        <!-- Image -->
        <div class="relative z-10 overflow-hidden rounded-2xl" style="box-shadow: var(--shadow-hero);">
          <img
            src="/images/about-showroom.jpg"
            alt={content.imgAlt}
            loading="lazy"
            class="w-full object-cover"
            style="aspect-ratio: 4/5; max-height: 580px;"
            onerror="this.parentElement.style.background='linear-gradient(135deg,var(--color-walnut),var(--color-green))'; this.remove();"
          />
          <!-- Gold corner accent -->
          <div
            class="absolute pointer-events-none"
            style={`top: 1.25rem; ${isAr ? 'right: 1.25rem;' : 'left: 1.25rem;'} width: 48px; height: 48px; border-top: 2px solid var(--color-gold); ${isAr ? 'border-right: 2px solid var(--color-gold);' : 'border-left: 2px solid var(--color-gold);'}`}
            aria-hidden="true"
          ></div>
          <div
            class="absolute pointer-events-none"
            style={`bottom: 1.25rem; ${isAr ? 'left: 1.25rem;' : 'right: 1.25rem;'} width: 48px; height: 48px; border-bottom: 2px solid var(--color-gold); ${isAr ? 'border-left: 2px solid var(--color-gold);' : 'border-right: 2px solid var(--color-gold);'}`}
            aria-hidden="true"
          ></div>
        </div>
      </div>

      <!-- Right: Text content -->
      <div data-reveal>
        <span class="section-eyebrow">{content.eyebrow}</span>
        <h2 class="section-title mb-6">{content.heading}</h2>

        <p class="section-subtitle mb-5" style="max-width: none;">
          {content.para1}
        </p>
        <p class="section-subtitle mb-10" style="max-width: none;">
          {content.para2}
        </p>

        <!-- Stats -->
        <div class="grid grid-cols-3 gap-4 mb-10">
          {[
            { val: content.stat1Val, label: content.stat1Label },
            { val: content.stat2Val, label: content.stat2Label },
            { val: content.stat3Val, label: content.stat3Label },
          ].map(stat => (
            <div
              class="text-center py-5 px-3 rounded-xl"
              style="background: var(--color-cream); box-shadow: var(--shadow-soft);"
            >
              <div
                class="font-serif font-bold mb-1"
                style="font-size: clamp(1.5rem, 2.5vw, 2rem); color: var(--color-walnut);"
              >
                {stat.val}
              </div>
              <div
                class="text-xs font-medium uppercase tracking-wide"
                style="color: var(--color-warm-gray); letter-spacing: 0.1em;"
              >
                {stat.label}
              </div>
            </div>
          ))}
        </div>

        <a href={ctaHref} class="btn-outline" style="color: var(--color-walnut); border-color: var(--color-walnut);">
          {content.cta}
        </a>
      </div>
    </div>
  </div>
</section>
