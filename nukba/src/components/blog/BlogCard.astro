---
interface Props {
  slug: string;
  title: string;
  excerpt: string;
  coverImage: string;
  category: string;
  publishDate: Date;
  readingTime?: number;
  featured?: boolean;
  lang?: 'en' | 'ar';
}

const {
  slug,
  title,
  excerpt,
  coverImage,
  category,
  publishDate,
  readingTime,
  featured = false,
  lang = 'en',
} = Astro.props;

const isAr = lang === 'ar';
const postUrl = `/blog/${slug}`;

const categoryLabels: Record<string, { en: string; ar: string }> = {
  guide:     { en: 'Guide',     ar: 'دليل' },
  trends:    { en: 'Trends',    ar: 'اتجاهات' },
  tips:      { en: 'Tips',      ar: 'نصائح' },
  materials: { en: 'Materials', ar: 'خامات' },
  spaces:    { en: 'Spaces',    ar: 'مساحات' },
};

const catLabel = isAr
  ? (categoryLabels[category]?.ar ?? category)
  : (categoryLabels[category]?.en ?? category);

// Format date: "May 2025"
const dateStr = publishDate.toLocaleDateString(isAr ? 'ar-EG' : 'en-US', {
  month: 'long',
  year: 'numeric',
});

const readMoreLabel = isAr ? 'اقرأ المزيد ←' : 'Read More →';
const minLabel      = isAr ? 'د'              : 'min';
---

<article class="card group relative flex flex-col h-full" dir={isAr ? 'rtl' : 'ltr'}>
  {/* Featured badge */}
  {featured && (
    <span
      class="absolute top-3 z-10 px-2.5 py-1 text-xs font-bold uppercase tracking-widest rounded-full"
      style={`${isAr ? 'right:0.75rem;' : 'left:0.75rem;'} background:var(--color-gold); color:var(--color-walnut-dark);`}
    >
      {isAr ? 'مميز' : 'Featured'}
    </span>
  )}

  {/* Cover image — full-card link */}
  <a href={postUrl} class="block overflow-hidden flex-shrink-0" style="aspect-ratio:16/9;" aria-label={title} tabindex="-1">
    {coverImage ? (
      <img
        src={coverImage}
        alt={title}
        loading="lazy"
        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center" style="background:var(--color-beige-dark);">
        <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"
          style="color:var(--color-warm-gray);" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="2"/>
          <circle cx="8.5" cy="8.5" r="1.5"/>
          <polyline points="21 15 16 10 5 21"/>
        </svg>
      </div>
    )}
  </a>

  {/* Content */}
  <div class="flex flex-col flex-1 p-6 gap-3">
    {/* Category chip */}
    <span
      class="inline-block self-start px-3 py-1 text-xs font-semibold uppercase tracking-wider rounded-full"
      style="background:rgba(196,164,74,0.12); color:var(--color-gold); border:1px solid rgba(196,164,74,0.3); width:fit-content;"
    >
      {catLabel}
    </span>

    {/* Title */}
    <a href={postUrl} class="block">
      <h3
        class="font-serif leading-snug"
        style="font-size:1.1rem; font-weight:600; color:var(--color-walnut); overflow:hidden; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;"
      >
        {title}
      </h3>
    </a>

    {/* Excerpt */}
    <p
      class="text-sm flex-1"
      style="color:var(--color-warm-gray); line-height:1.65; overflow:hidden; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;"
    >
      {excerpt}
    </p>

    {/* Meta row */}
    <div class="flex items-center justify-between gap-3 pt-1">
      <div class="flex items-center gap-3">
        <time
          datetime={publishDate.toISOString()}
          class="text-xs"
          style="color:var(--color-warm-gray);"
        >
          {dateStr}
        </time>
        {readingTime && (
          <span class="text-xs" style="color:var(--color-warm-gray);">
            · {readingTime} {minLabel}
          </span>
        )}
      </div>

      <a
        href={postUrl}
        class="text-xs font-semibold transition-colors duration-200 flex-shrink-0"
        style="color:var(--color-gold);"
      >
        {readMoreLabel}
      </a>
    </div>
  </div>
</article>
