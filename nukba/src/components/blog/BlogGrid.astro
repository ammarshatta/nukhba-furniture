---
import type { CollectionEntry } from 'astro:content';
import BlogCard from './BlogCard.astro';

interface Props {
  posts: CollectionEntry<'blog'>[];
  lang?: 'en' | 'ar';
  showFilter?: boolean;
}

const { posts, lang = 'en', showFilter = false } = Astro.props;
const isAr = lang === 'ar';

// Derive unique categories in first-seen order
const categories: string[] = [];
for (const p of posts) {
  if (!categories.includes(p.data.category)) {
    categories.push(p.data.category);
  }
}

const allLabel = isAr ? 'الكل' : 'All';

const categoryLabels: Record<string, { en: string; ar: string }> = {
  guide:     { en: 'Guide',     ar: 'دليل' },
  trends:    { en: 'Trends',    ar: 'اتجاهات' },
  tips:      { en: 'Tips',      ar: 'نصائح' },
  materials: { en: 'Materials', ar: 'خامات' },
  spaces:    { en: 'Spaces',    ar: 'مساحات' },
};

function getCatLabel(cat: string) {
  return isAr
    ? (categoryLabels[cat]?.ar ?? cat)
    : (categoryLabels[cat]?.en ?? cat.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()));
}
---

<div dir={isAr ? 'rtl' : 'ltr'}>
  {/* Category filter tabs */}
  {showFilter && categories.length > 1 && (
    <div
      class="flex flex-wrap gap-2 mb-10"
      role="tablist"
      aria-label={isAr ? 'تصفية حسب الفئة' : 'Filter by category'}
      id="blog-filter-tabs"
    >
      <button
        class="blog-filter-tab active"
        data-filter="all"
        role="tab"
        aria-selected="true"
        aria-controls="blog-grid"
      >
        {allLabel}
      </button>
      {categories.map(cat => (
        <button
          class="blog-filter-tab"
          data-filter={cat}
          role="tab"
          aria-selected="false"
          aria-controls="blog-grid"
        >
          {getCatLabel(cat)}
        </button>
      ))}
    </div>
  )}

  {/* Grid */}
  <div
    id="blog-grid"
    class="grid gap-6 grid-cols-1 md:grid-cols-2 lg:grid-cols-3"
    role="list"
  >
    {posts.map((post, i) => (
      <div
        role="listitem"
        data-blog-item
        data-category={post.data.category}
        data-reveal
        style={`animation-delay:${(i % 3) * 0.08}s;`}
      >
        <BlogCard
          slug={post.data.slug}
          title={post.data.title}
          excerpt={post.data.excerpt}
          coverImage={post.data.coverImage}
          category={post.data.category}
          publishDate={post.data.publishDate}
          readingTime={post.data.readingTime}
          featured={post.data.featured}
          lang={lang}
        />
      </div>
    ))}
  </div>

  {posts.length === 0 && (
    <div class="text-center py-24">
      <p style="color:var(--color-warm-gray); font-size:1.0625rem;">
        {isAr ? 'لا توجد مقالات متاحة حالياً.' : 'No articles available at the moment.'}
      </p>
    </div>
  )}
</div>

<style>
  .blog-filter-tab {
    padding: 0.5rem 1.25rem;
    border-radius: 9999px;
    border: 1.5px solid var(--color-beige-dark);
    background: transparent;
    color: var(--color-warm-gray);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(.16,1,.3,1);
    font-family: var(--font-sans);
  }
  .blog-filter-tab:hover {
    border-color: var(--color-gold);
    color: var(--color-walnut);
  }
  .blog-filter-tab.active {
    background: var(--color-walnut);
    color: var(--color-cream);
    border-color: var(--color-walnut);
  }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.blog-filter-tab');
  const items = document.querySelectorAll<HTMLElement>('[data-blog-item]');

  if (tabs.length > 0) {
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const filter = tab.dataset.filter ?? 'all';

        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        items.forEach(item => {
          const cat = item.dataset.category ?? '';
          const show = filter === 'all' || cat === filter;
          item.style.display = show ? '' : 'none';
        });
      });
    });
  }
</script>
