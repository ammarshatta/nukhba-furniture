---
interface Props {
  lang?: 'en' | 'ar';
  currentPath?: string;
}

const { lang = 'en', currentPath = '/' } = Astro.props;
const isAr = lang === 'ar';

function altPath(p: string) {
  if (isAr) return p.replace(/^\/ar/, '') || '/';
  return '/ar' + (p === '/' ? '' : p);
}

const navLinks = isAr
  ? [
      { href: '/ar', label: 'الرئيسية' },
      { href: '/collections', label: 'المجموعات' },
      { href: '/products', label: 'المنتجات' },
      { href: '/blog', label: 'المدونة' },
      { href: '/about', label: 'عن نُخبة' },
      { href: '/contact', label: 'اتصل بنا' },
    ]
  : [
      { href: '/', label: 'Home' },
      { href: '/collections', label: 'Collections' },
      { href: '/products', label: 'Products' },
      { href: '/blog', label: 'Journal' },
      { href: '/about', label: 'About' },
      { href: '/contact', label: 'Contact' },
    ];

const waNumber = import.meta.env.PUBLIC_WA_NUMBER || '201234567890';
const waUrl = `https://wa.me/${waNumber}`;
---

<header
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500"
  id="site-nav"
  style="background:rgba(250,250,247,0.9); backdrop-filter:blur(16px); -webkit-backdrop-filter:blur(16px);"
>
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="flex items-center justify-between" style="height:72px;">

      <!-- Logo -->
      <a
        href={isAr ? '/ar' : '/'}
        class="flex items-center gap-3 group"
        aria-label="Nukhba - Home"
      >
        <div
          class="w-9 h-9 rounded-lg flex items-center justify-center font-bold transition-transform group-hover:scale-105"
          style="background:var(--color-walnut); color:var(--color-gold); font-family:var(--font-serif); font-size:1.1rem;"
        >
          N
        </div>
        <div class="hidden sm:flex flex-col leading-none">
          <span style="font-family:var(--font-serif); color:var(--color-walnut); font-size:1.125rem; font-weight:600; letter-spacing:-0.02em;">Nukhba</span>
          <span style="font-family:'Amiri',serif; color:var(--color-gold); font-size:0.875rem;" dir="rtl">نُخبة</span>
        </div>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-7" aria-label="Main navigation">
        {navLinks.map(link => (
          <a
            href={link.href}
            class="text-sm font-medium transition-colors duration-200 relative group py-1"
            style={currentPath === link.href
              ? 'color:var(--color-walnut);'
              : 'color:var(--color-warm-gray);'}
          >
            {link.label}
            <span
              class="absolute -bottom-0.5 left-0 right-0 h-px origin-left scale-x-0 transition-transform duration-300 group-hover:scale-x-100"
              style="background:var(--color-gold);"
            ></span>
          </a>
        ))}
      </nav>

      <!-- Right actions -->
      <div class="flex items-center gap-3">
        <a
          href={altPath(currentPath)}
          class="hidden sm:flex items-center text-xs font-medium px-3 py-1.5 rounded-full border transition-colors hover:border-current"
          style="border-color:var(--color-beige-dark); color:var(--color-warm-gray);"
          aria-label={isAr ? 'Switch to English' : 'Arabic'}
        >
          {isAr ? 'EN' : 'عر'}
        </a>

        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:flex items-center gap-2 btn-primary"
          style="padding:0.5rem 1rem; font-size:0.75rem;"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          {isAr ? 'واتساب' : 'WhatsApp'}
        </a>

        <!-- Mobile hamburger -->
        <button
          id="nav-toggle"
          class="lg:hidden p-2 rounded-lg"
          style="color:var(--color-walnut);"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg id="icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="16" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
          <svg id="icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" class="hidden" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden border-t"
    style="border-color:var(--color-beige-dark); background:var(--color-cream);"
  >
    <nav class="max-w-7xl mx-auto px-6 py-5 flex flex-col gap-1" aria-label="Mobile navigation">
      {navLinks.map(link => (
        <a
          href={link.href}
          class="py-3 px-4 rounded-xl text-sm font-medium transition-colors hover:bg-beige"
          style="color:var(--color-walnut);"
        >
          {link.label}
        </a>
      ))}
      <div class="flex gap-3 mt-4 pt-4 border-t" style="border-color:var(--color-beige-dark);">
        <a
          href={altPath(currentPath)}
          class="flex-1 text-center py-3 rounded-xl border text-sm font-medium"
          style="border-color:var(--color-beige-dark); color:var(--color-warm-gray);"
        >
          {isAr ? 'English' : 'العربية'}
        </a>
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 text-center btn-primary rounded-xl"
          style="padding:0.75rem 1rem; font-size:0.8rem; border-radius:0.75rem;"
        >
          WhatsApp
        </a>
      </div>
    </nav>
  </div>
</header>

<!-- Spacer for fixed nav -->
<div aria-hidden="true" style="height:72px;"></div>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  const nav = document.getElementById('site-nav');

  toggle?.addEventListener('click', () => {
    const isHidden = menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', !isHidden);
    iconOpen?.classList.toggle('hidden', isHidden);
    iconClose?.classList.toggle('hidden', !isHidden);
    toggle.setAttribute('aria-expanded', String(isHidden));
  });

  window.addEventListener('scroll', () => {
    if (nav) {
      nav.style.boxShadow = window.scrollY > 20
        ? '0 2px 24px rgba(61,43,31,.08)'
        : 'none';
    }
  }, { passive: true });
</script>
