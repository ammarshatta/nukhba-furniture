---
interface Props {
  lang?: 'en' | 'ar';
}
const { lang = 'en' } = Astro.props;
const isAr = lang === 'ar';
const waNumber = import.meta.env.PUBLIC_WA_NUMBER || '201040101056';
const instagram = import.meta.env.PUBLIC_INSTAGRAM_URL || 'https://www.instagram.com/shatta_furniture';
const facebook = import.meta.env.PUBLIC_FACEBOOK_URL || 'https://www.facebook.com/citymodern';
const year = new Date().getFullYear();
// Arabic lives at the root; English under /en. Prefix internal links accordingly.
const base = isAr ? '' : '/en';
---

<footer style="background:var(--color-walnut); color:var(--color-beige);">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 pt-16 pb-8">

    <!-- Top grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 pb-12 border-b" style="border-color:rgba(245,239,227,.12);">

      <!-- Brand -->
      <div class="lg:col-span-2">
        <div class="flex items-center gap-2 mb-5">
          <svg width="36" height="36" viewBox="0 0 44 44" fill="none" aria-hidden="true">
            <path d="M8 38 L8 20 Q8 8 22 8 Q36 8 36 20 L36 38" stroke="rgba(245,239,227,.8)" stroke-width="2" fill="none" stroke-linecap="round"/>
            <path d="M13 38 L13 21 Q13 13 22 13 Q31 13 31 21 L31 38" stroke="var(--color-gold)" stroke-width="1.5" fill="none" stroke-linecap="round" opacity=".8"/>
            <line x1="5" y1="38" x2="39" y2="38" stroke="rgba(245,239,227,.8)" stroke-width="2" stroke-linecap="round"/>
            <circle cx="22" cy="9" r="2.5" fill="var(--color-gold)"/>
            <rect x="20.5" y="22.5" width="3" height="3" fill="var(--color-gold)" opacity=".5" transform="rotate(45 22 24)"/>
          </svg>
          <div class="flex flex-col leading-none">
            <span style="font-family:'Amiri',serif; font-size:1.5rem; font-weight:400; color:rgba(245,239,227,.85); line-height:1; letter-spacing:0.5px;" dir="rtl">شطا</span>
            <span style="font-family:'Inter',sans-serif; font-size:0.58rem; color:var(--color-gold); letter-spacing:3px; text-transform:uppercase; margin-top:2px;">Shatta Furniture</span>
          </div>
        </div>
        <p class="text-sm leading-relaxed max-w-sm" style="color:rgba(245,239,227,.65);">
          {isAr
            ? 'شطا هو وجهتك للأثاث الفاخر الحديث في مصر ومنطقة الشرق الأوسط. نصمم مساحات استثنائية تعكس ذوقك الرفيع.'
            : 'Shatta is Egypt\'s premier luxury furniture brand, crafting exceptional living spaces with premium European-inspired designs for discerning homes across Egypt and the Middle East.'}
        </p>
        <!-- Social links -->
        <div class="flex items-center gap-4 mt-6">
          <a
            href={instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full flex items-center justify-center transition-colors"
            style="background:rgba(245,239,227,.1); color:var(--color-beige);"
            aria-label="Instagram"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <a
            href={facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full flex items-center justify-center transition-colors"
            style="background:rgba(245,239,227,.1); color:var(--color-beige);"
            aria-label="Facebook"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <a
            href={`https://wa.me/${waNumber}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full flex items-center justify-center transition-colors"
            style="background:rgba(245,239,227,.1); color:var(--color-beige);"
            aria-label="WhatsApp"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Collections -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-widest mb-5" style="color:var(--color-gold);">
          {isAr ? 'المجموعات' : 'Collections'}
        </h3>
        <ul class="space-y-3 text-sm" style="color:rgba(245,239,227,.65);">
          {[
            { href: '/collections/living-room', en: 'Living Room', ar: 'غرفة المعيشة' },
            { href: '/collections/bedroom', en: 'Bedroom', ar: 'غرفة النوم' },
            { href: '/collections/dining', en: 'Dining Room', ar: 'غرفة الطعام' },
            { href: '/collections/office', en: 'Home Office', ar: 'مكتب منزلي' },
          ].map(l => (
            <li>
              <a href={base + l.href} class="hover:text-beige transition-colors" style="color:inherit;">
                {isAr ? l.ar : l.en}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company + Contact -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-widest mb-5" style="color:var(--color-gold);">
          {isAr ? 'الشركة' : 'Company'}
        </h3>
        <ul class="space-y-3 text-sm mb-6" style="color:rgba(245,239,227,.65);">
          {[
            { href: '/about', en: 'About Shatta', ar: 'عن شطا' },
            { href: '/blog', en: 'Journal', ar: 'المدونة' },
            { href: '/faq', en: 'FAQ', ar: 'الأسئلة الشائعة' },
            { href: '/locations', en: 'Showrooms', ar: 'المعارض' },
            { href: '/contact', en: 'Contact Us', ar: 'اتصل بنا' },
            { href: '/return-policy', en: 'Return Policy', ar: 'سياسة الإرجاع' },
          ].map(l => (
            <li>
              <a href={base + l.href} class="transition-colors" style="color:inherit;">
                {isAr ? l.ar : l.en}
              </a>
            </li>
          ))}
        </ul>
        <address class="not-italic text-sm space-y-1" style="color:rgba(245,239,227,.5);">
          <p>Cairo, Egypt</p>
          <a href={`tel:+${waNumber}`} class="hover:text-beige transition-colors block" style="color:inherit;">
            +{waNumber}
          </a>
        </address>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-6 text-xs" style="color:rgba(245,239,227,.4);">
      <p>© {year} Shatta Luxury Furniture. {isAr ? 'جميع الحقوق محفوظة.' : 'All rights reserved.'}</p>
      <p class="text-center">
        {isAr
          ? 'أثاث فاخر مودرن • مصر والشرق الأوسط'
          : 'Luxury Modern Furniture • Egypt & Middle East'}
      </p>
    </div>
  </div>
</footer>
