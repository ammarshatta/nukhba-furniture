---
import BaseHead from '../components/layout/BaseHead.astro';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppFAB from '../components/layout/WhatsAppFAB.astro';
import SEO from '../components/seo/SEO.astro';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  lang?: 'en' | 'ar';
  alternateUrl?: string;
  ogImage?: string;
  ogType?: 'website' | 'product' | 'article';
  product?: CollectionEntry<'products'>;
  article?: CollectionEntry<'blog'>;
  breadcrumbs?: Array<{ name: string; url: string }>;
  faqs?: Array<{ question: string; answer: string }>;
  noindex?: boolean;
  currentPath?: string;
}

const {
  title,
  description,
  canonical,
  lang = 'en',
  alternateUrl,
  ogImage,
  ogType = 'website',
  product,
  article,
  breadcrumbs,
  faqs,
  noindex = false,
  currentPath = '/',
} = Astro.props;

const dir = lang === 'ar' ? 'rtl' : 'ltr';
const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://shattafurniture.com';
const resolvedCanonical = canonical ?? `${siteUrl}${currentPath}`;
---

<!DOCTYPE html>
<html lang={lang} dir={dir} class="scroll-smooth">
<head>
  <BaseHead />
  <SEO
    title={title}
    description={description}
    canonical={resolvedCanonical}
    lang={lang}
    alternateUrl={alternateUrl}
    ogImage={ogImage}
    ogType={ogType}
    product={product}
    article={article}
    breadcrumbs={breadcrumbs}
    faqs={faqs}
    noindex={noindex}
  />
</head>
<body style="background:var(--color-cream);">
  <Nav lang={lang} currentPath={currentPath} />
  <main id="main-content">
    <slot />
  </main>
  <Footer lang={lang} />
  <WhatsAppFAB lang={lang} />

  <!-- Reveal on scroll -->
  <script>
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add('revealed');
            observer.unobserve(e.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
    );
    document.querySelectorAll('[data-reveal]').forEach(el => observer.observe(el));
  </script>

  <!--
    WhatsApp links: inject the current page URL into the prefilled message so the
    sales team sees exactly which page the customer came from, and fire a GA4 +
    Clarity event so clicks are trackable. One delegated handler covers every
    WhatsApp button on the site (FAB, product cards, CTAs, nav, footer…).
  -->
  <script>
    document.addEventListener('click', (e) => {
      const target = e.target;
      const link = target && target.closest
        ? target.closest('a[href*="wa.me"], a[href*="api.whatsapp.com"]')
        : null;
      if (!link) return;

      // Append the current page URL to the prefilled message (idempotent —
      // dataset.waText keeps the original message so repeat clicks don't stack).
      try {
        const url = new URL(link.href);
        const original = link.dataset.waText ?? (url.searchParams.get('text') || '');
        link.dataset.waText = original;
        const pageUrl = window.location.href.split('#')[0];
        const sep = original ? '\n\n' : '';
        url.searchParams.set('text', original + sep + pageUrl);
        link.href = url.toString();
      } catch (_) { /* leave href untouched on parse failure */ }

      // Track the click.
      const label = (link.getAttribute('aria-label') || link.textContent || '')
        .replace(/\s+/g, ' ').trim().slice(0, 80);
      if (window.gtag) {
        window.gtag('event', 'whatsapp_click', {
          button_label: label,
          page_location: window.location.href,
          page_title: document.title,
        });
      }
      if (window.clarity) {
        window.clarity('event', 'whatsapp_click');
      }
    }, true);
  </script>
</body>
</html>
