---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import BlogGrid from '../components/blog/BlogGrid.astro';

export interface Props {
  post: CollectionEntry<'blog'>;
  lang?: 'en' | 'ar';
  relatedPosts?: CollectionEntry<'blog'>[];
  alternateUrl?: string;
  bodyAr?: string;
}

const { post, lang = 'en', relatedPosts = [], alternateUrl, bodyAr } = Astro.props;

function inlineRender(text: string): string {
  return text
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/\*([^*]+?)\*/g, '<em>$1</em>')
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');
}

function renderMarkdown(text: string): string {
  const lines = text.split('\n');
  const out: string[] = [];
  let inUl = false;
  let pending: string[] = [];
  function flushP() {
    if (pending.length) { out.push(`<p>${inlineRender(pending.join(' '))}</p>`); pending = []; }
  }
  function closeUl() { if (inUl) { out.push('</ul>'); inUl = false; } }
  for (const raw of lines) {
    const t = raw.trim();
    if (!t) { flushP(); closeUl(); continue; }
    if (t === '---') { flushP(); closeUl(); out.push('<hr>'); continue; }
    if (t.startsWith('### ')) { flushP(); closeUl(); out.push(`<h3>${inlineRender(t.slice(4))}</h3>`); continue; }
    if (t.startsWith('## ')) { flushP(); closeUl(); out.push(`<h2>${inlineRender(t.slice(3))}</h2>`); continue; }
    if (t.startsWith('# ')) { flushP(); closeUl(); out.push(`<h1>${inlineRender(t.slice(2))}</h1>`); continue; }
    if (t.startsWith('- ')) { flushP(); if (!inUl) { out.push('<ul>'); inUl = true; } out.push(`<li>${inlineRender(t.slice(2))}</li>`); continue; }
    closeUl(); pending.push(t);
  }
  flushP(); closeUl();
  return out.join('\n');
}
const isAr = lang === 'ar';
const d = post.data;

// Use Arabic title/excerpt on the Arabic page, English on /en.
const displayTitle = isAr ? (d.titleAr || d.title) : d.title;
const displayExcerpt = isAr ? (d.excerptAr || d.excerpt) : d.excerpt;

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://shattafurniture.com';

const breadcrumbs = [
  { name: isAr ? 'الرئيسية' : 'Home',    url: `${siteUrl}${isAr ? '/' : '/en'}` },
  { name: isAr ? 'المدونة'  : 'Blog',    url: `${siteUrl}${isAr ? '/blog' : '/en/blog'}` },
  { name: displayTitle,                   url: `${siteUrl}/blog/${d.slug}` },
];

const categoryLabels: Record<string, { en: string; ar: string }> = {
  guide:     { en: 'Guide',     ar: 'دليل' },
  trends:    { en: 'Trends',    ar: 'اتجاهات' },
  tips:      { en: 'Tips',      ar: 'نصائح' },
  materials: { en: 'Materials', ar: 'خامات' },
  spaces:    { en: 'Spaces',    ar: 'مساحات' },
};

const catLabel = isAr
  ? (categoryLabels[d.category]?.ar ?? d.category)
  : (categoryLabels[d.category]?.en ?? d.category);

const dateStr = d.publishDate.toLocaleDateString(isAr ? 'ar-EG' : 'en-US', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const updatedStr = d.updatedDate
  ? d.updatedDate.toLocaleDateString(isAr ? 'ar-EG' : 'en-US', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    })
  : null;

const backLabel      = isAr ? '← العودة إلى المدونة' : '← Back to Blog';
const relatedLabel   = isAr ? 'مقالات ذات صلة'       : 'Related Articles';
const byLabel        = isAr ? 'بقلم'                  : 'By';
const minLabel       = isAr ? 'دقيقة قراءة'           : 'min read';
const updatedLabel   = isAr ? 'تحديث:'                : 'Updated:';
---

<BaseLayout
  title={`${displayTitle} | شطا`}
  description={displayExcerpt}
  currentPath={isAr ? `/blog/${d.slug}` : `/en/blog/${d.slug}`}
  alternateUrl={alternateUrl}
  lang={lang}
  ogType="article"
  ogImage={d.coverImage}
  article={post}
  breadcrumbs={breadcrumbs}
>
  {/* ── Cover image ── */}
  <div class="w-full overflow-hidden" style="max-height:600px; background:var(--color-beige-dark);">
    {d.coverImage ? (
      <img
        src={d.coverImage}
        alt={displayTitle}
        loading="eager"
        fetchpriority="high"
        class="w-full object-cover"
        style="max-height:600px; width:100%;"
      />
    ) : (
      <div
        class="w-full flex items-center justify-center"
        style="height:400px; background:var(--color-beige-dark);"
        aria-hidden="true"
      >
        <svg width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.75"
          style="color:var(--color-warm-gray);" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="2"/>
          <circle cx="8.5" cy="8.5" r="1.5"/>
          <polyline points="21 15 16 10 5 21"/>
        </svg>
      </div>
    )}
  </div>

  {/* ── Article header ── */}
  <header
    class="py-12 lg:py-16"
    dir={isAr ? 'rtl' : 'ltr'}
    style="background-color:var(--color-beige);"
  >
    <div class="max-w-3xl mx-auto px-6 lg:px-4">
      {/* Category chip */}
      <span
        class="inline-block mb-4 px-3 py-1 text-xs font-semibold uppercase tracking-wider rounded-full"
        style="background:rgba(196,164,74,0.14); color:var(--color-gold); border:1px solid rgba(196,164,74,0.3);"
      >
        {catLabel}
      </span>

      {/* Title */}
      <h1
        class="section-title mb-5"
        style="line-height:1.15;"
      >
        {displayTitle}
      </h1>

      {/* Excerpt */}
      <p
        class="section-subtitle mb-8"
        style="max-width:100%; font-size:1.0625rem; line-height:1.75;"
      >
        {displayExcerpt}
      </p>

      {/* Meta row */}
      <div class="flex flex-wrap items-center gap-4 text-sm" style="color:var(--color-warm-gray);">
        <span>{byLabel} <strong style="color:var(--color-walnut); font-weight:600;">{d.author}</strong></span>
        <span aria-hidden="true" style="color:var(--color-beige-dark);">·</span>
        <time datetime={d.publishDate.toISOString()}>{dateStr}</time>
        {d.readingTime && (
          <>
            <span aria-hidden="true" style="color:var(--color-beige-dark);">·</span>
            <span>{d.readingTime} {minLabel}</span>
          </>
        )}
        {updatedStr && (
          <>
            <span aria-hidden="true" style="color:var(--color-beige-dark);">·</span>
            <span>{updatedLabel} {updatedStr}</span>
          </>
        )}
      </div>
    </div>
  </header>

  {/* ── Article body ── */}
  <article class="prose-nukhba max-w-3xl mx-auto px-4 py-12" dir={isAr ? 'rtl' : 'ltr'}>
    {isAr && bodyAr ? <Fragment set:html={renderMarkdown(bodyAr)} /> : <slot />}
  </article>

  {/* ── Back to Blog ── */}
  <div
    class="max-w-3xl mx-auto px-4 pb-12"
    dir={isAr ? 'rtl' : 'ltr'}
  >
    <a
      href={isAr ? '/blog' : '/en/blog'}
      class="btn-outline inline-flex items-center gap-2"
      style="color:var(--color-walnut); border-color:var(--color-walnut);"
    >
      {backLabel}
    </a>
  </div>

  {/* ── Related articles ── */}
  {relatedPosts.length > 0 && (
    <section
      class="py-16 lg:py-20"
      dir={isAr ? 'rtl' : 'ltr'}
      style="background-color:var(--color-beige);"
      data-reveal
    >
      <div class="max-w-7xl mx-auto px-6 lg:px-12">
        <h2 class="section-title mb-10">{relatedLabel}</h2>
        <BlogGrid posts={relatedPosts} lang={lang} showFilter={false} />
      </div>
    </section>
  )}
</BaseLayout>

<style>
  /* ── Prose styles scoped to article body ── */
  .prose-nukhba {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--color-matte);
  }

  .prose-nukhba :global(h1),
  .prose-nukhba :global(h2),
  .prose-nukhba :global(h3),
  .prose-nukhba :global(h4) {
    font-family: var(--font-serif);
    color: var(--color-walnut);
    font-weight: 600;
    line-height: 1.25;
    margin-top: 2.25rem;
    margin-bottom: 0.875rem;
    letter-spacing: -0.01em;
  }

  .prose-nukhba :global(h1) { font-size: clamp(1.75rem, 3vw, 2.5rem); }
  .prose-nukhba :global(h2) { font-size: clamp(1.35rem, 2.5vw, 1.875rem); }
  .prose-nukhba :global(h3) { font-size: 1.25rem; }
  .prose-nukhba :global(h4) { font-size: 1.0625rem; }

  .prose-nukhba :global(p) {
    margin-bottom: 1.5rem;
  }

  .prose-nukhba :global(a) {
    color: var(--color-gold);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s;
  }
  .prose-nukhba :global(a:hover) {
    color: var(--color-gold-dark);
  }

  .prose-nukhba :global(strong) {
    color: var(--color-walnut);
    font-weight: 700;
  }

  .prose-nukhba :global(em) {
    font-style: italic;
    color: var(--color-warm-gray);
  }

  .prose-nukhba :global(ul),
  .prose-nukhba :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .prose-nukhba :global(li) {
    margin-bottom: 0.5rem;
  }

  .prose-nukhba :global(blockquote) {
    border-left: 3px solid var(--color-gold);
    padding-left: 1.25rem;
    margin: 2rem 0;
    color: var(--color-warm-gray);
    font-style: italic;
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .prose-nukhba :global(hr) {
    border: none;
    border-top: 1px solid var(--color-beige-dark);
    margin: 2.5rem 0;
  }

  .prose-nukhba :global(img) {
    border-radius: var(--radius-lg);
    margin: 2rem auto;
    max-width: 100%;
    height: auto;
    display: block;
  }

  .prose-nukhba :global(pre) {
    background: var(--color-matte);
    color: var(--color-cream);
    border-radius: var(--radius);
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    line-height: 1.65;
  }

  .prose-nukhba :global(code) {
    background: rgba(61,43,31,0.07);
    color: var(--color-walnut);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    font-size: 0.875em;
  }

  .prose-nukhba :global(pre code) {
    background: transparent;
    color: inherit;
    padding: 0;
    border-radius: 0;
    font-size: inherit;
  }

  .prose-nukhba :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.5rem;
    font-size: 0.9375rem;
  }

  .prose-nukhba :global(th) {
    background: var(--color-beige);
    color: var(--color-walnut);
    font-weight: 600;
    padding: 0.75rem 1rem;
    border-bottom: 2px solid var(--color-beige-dark);
    text-align: left;
  }

  .prose-nukhba :global(td) {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-beige-dark);
    color: var(--color-warm-gray);
  }
</style>
