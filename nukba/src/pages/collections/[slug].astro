---
export const prerender = true;

import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductGrid from '../../components/product/ProductGrid.astro';
import { buildCollectionPageSchema } from '../../lib/seo';

export async function getStaticPaths() {
  const categories = await getCollection('categories');
  return categories.map(category => ({
    params: { slug: category.data.slug },
    props: { category },
  }));
}

interface Props {
  category: CollectionEntry<'categories'>;
}

const { category } = Astro.props;
const d = category.data;

const categoryProducts = await getCollection(
  'products',
  p => p.data.active && p.data.category === d.slug,
);

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://shattafurniture.com';

const breadcrumbs = [
  { name: 'الرئيسية', url: `${siteUrl}/` },
  { name: 'المجموعات', url: `${siteUrl}/collections` },
  { name: d.nameAr || d.name, url: `${siteUrl}/collections/${d.slug}` },
];

const collectionSchema = buildCollectionPageSchema(category, categoryProducts);

const productCount = categoryProducts.length;
const countLabel = `${productCount} ${productCount === 1 ? 'منتج متاح' : 'منتجات متاحة'}`;
---

<BaseLayout
  title={`${d.nameAr || d.name} — أثاث فاخر | شطا`}
  description={d.descriptionAr || d.description}
  currentPath={`/collections/${d.slug}`}
  alternateUrl={`/en/collections/${d.slug}`}
  lang="ar"
  ogType="website"
  ogImage={d.image}
  breadcrumbs={breadcrumbs}
>
  <!-- Collection page schema — valid to place in <body> per HTML spec -->
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema, null, 2)} />

  <!-- ── Hero Banner ──────────────────────────────────────────── -->
  <section
    class="relative overflow-hidden"
    style="min-height:min(480px,60vw);"
    aria-labelledby="collection-heading"
  >
    <!-- Background image -->
    {d.image && (
      <img
        src={d.image}
        alt={d.name}
        loading="eager"
        class="absolute inset-0 w-full h-full object-cover"
        style="transform-origin:center;"
      />
    )}

    <!-- Gradient overlay -->
    <div
      class="absolute inset-0"
      style="background:linear-gradient(to right, rgba(20,10,5,0.82) 0%, rgba(20,10,5,0.55) 55%, rgba(20,10,5,0.25) 100%);"
      aria-hidden="true"
    ></div>

    <!-- Hero content -->
    <div class="relative flex items-end h-full max-w-7xl mx-auto px-6 lg:px-12 pb-14 pt-28">
      <div class="max-w-xl">
        <!-- Breadcrumb nav -->
        <nav aria-label="Breadcrumb" class="mb-6">
          <ol class="flex items-center gap-2 flex-wrap" style="font-size:0.8rem; color:rgba(255,255,255,0.6);">
            <li>
              <a
                href="/"
                style="color:inherit; transition:color 0.2s;"
                onmouseover="this.style.color='var(--color-gold-light)'"
                onmouseout="this.style.color='rgba(255,255,255,0.6)'"
              >
                الرئيسية
              </a>
            </li>
            <li aria-hidden="true" style="color:rgba(255,255,255,0.35);">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                <polyline points="15 18 9 12 15 6"/>
              </svg>
            </li>
            <li>
              <a
                href="/collections"
                style="color:inherit; transition:color 0.2s;"
                onmouseover="this.style.color='var(--color-gold-light)'"
                onmouseout="this.style.color='rgba(255,255,255,0.6)'"
              >
                المجموعات
              </a>
            </li>
            <li aria-hidden="true" style="color:rgba(255,255,255,0.35);">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                <polyline points="15 18 9 12 15 6"/>
              </svg>
            </li>
            <li aria-current="page" style="color:rgba(255,255,255,0.9); font-weight:500;">
              {d.nameAr || d.name}
            </li>
          </ol>
        </nav>

        <!-- Eyebrow -->
        <span
          class="section-eyebrow"
          style="color:var(--color-gold-light);"
        >
          المجموعة
        </span>

        <!-- Heading -->
        <h1
          id="collection-heading"
          class="font-serif mt-2 mb-4"
          style="font-size:clamp(2rem,5vw,3.25rem); color:#fff; font-weight:600; line-height:1.15; letter-spacing:-0.02em;"
        >
          {d.nameAr || d.name}
        </h1>

        <!-- Description -->
        <p
          class="mb-6 leading-relaxed"
          style="font-size:1.0625rem; color:rgba(255,255,255,0.75); max-width:480px; line-height:1.7;"
        >
          {d.descriptionAr || d.description}
        </p>

        <!-- Product count badge -->
        <span
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold"
          style="background:rgba(196,164,74,0.18); color:var(--color-gold-light); border:1px solid rgba(196,164,74,0.4); backdrop-filter:blur(6px); letter-spacing:0.04em;"
          aria-live="polite"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 7H4a2 2 0 00-2 2v6a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2z"/>
            <path d="M16 3H8a2 2 0 00-2 2v2h12V5a2 2 0 00-2-2z"/>
          </svg>
          {countLabel}
        </span>
      </div>
    </div>
  </section>

  <!-- ── Products Section ─────────────────────────────────────── -->
  <section class="py-16 lg:py-24" style="background-color:var(--color-cream);">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      {productCount > 0 ? (
        <>
          <!-- Section header -->
          <div class="mb-10 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4" data-reveal>
            <div>
              <span class="section-eyebrow">{d.nameAr || d.name}</span>
              <h2 class="section-title" style="font-size:clamp(1.6rem,3vw,2.25rem);">
                {productCount} {productCount === 1 ? 'قطعة' : 'قطعة'} في هذه المجموعة
              </h2>
            </div>
            <a
              href="/collections"
              class="btn-outline self-start sm:self-auto flex-shrink-0"
              style="color:var(--color-walnut); border-color:var(--color-walnut);"
            >
              ← جميع المجموعات
            </a>
          </div>

          <!-- Product grid -->
          <ProductGrid products={categoryProducts} lang="ar" showFilter={false} />
        </>
      ) : (
        <!-- Empty state -->
        <div class="text-center py-24 max-w-md mx-auto" data-reveal>
          <div
            class="inline-flex items-center justify-center w-20 h-20 rounded-full mb-6"
            style="background:var(--color-beige-dark);"
            aria-hidden="true"
          >
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" style="color:var(--color-warm-gray);" aria-hidden="true">
              <rect x="2" y="7" width="20" height="14" rx="2"/>
              <path d="M16 3H8a2 2 0 00-2 2v2h12V5a2 2 0 00-2-2z"/>
              <line x1="12" y1="12" x2="12" y2="16"/>
              <line x1="10" y1="14" x2="14" y2="14"/>
            </svg>
          </div>
          <h2
            class="font-serif mb-3"
            style="font-size:1.5rem; color:var(--color-walnut);"
          >
            قريباً
          </h2>
          <p
            class="section-subtitle mb-8"
            style="margin-inline:auto; text-align:center;"
          >
            نعمل حالياً على تجميع منتجات مجموعة {d.nameAr || d.name}. تفقّد الصفحة قريباً أو استكشف مجموعاتنا الأخرى.
          </p>
          <div class="flex flex-wrap gap-3 justify-center">
            <a href="/collections" class="btn-primary">جميع المجموعات</a>
            <a href="/products" class="btn-outline" style="color:var(--color-walnut); border-color:var(--color-walnut);">تصفح جميع المنتجات</a>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- ── CTA Strip ─────────────────────────────────────────────── -->
  {productCount > 0 && (
    <section
      class="py-14"
      style="background-color:var(--color-walnut);"
    >
      <div class="max-w-3xl mx-auto px-6 text-center" data-reveal>
        <span class="section-eyebrow" style="color:var(--color-gold);">تحتاج مساعدة في الاختيار؟</span>
        <h2
          class="font-serif mt-2 mb-4"
          style="font-size:clamp(1.5rem,3vw,2rem); color:#fff; font-weight:600;"
        >
          مستشارونا في خدمتك
        </h2>
        <p
          class="mb-8 leading-relaxed"
          style="font-size:1rem; color:rgba(255,255,255,0.7); max-width:440px; margin-inline:auto;"
        >
          ناقش الأبعاد والخامات والتشطيبات مع متخصصي الأثاث لدينا — مجاناً تماماً.
        </p>
        <a
          href={`https://wa.me/${import.meta.env.PUBLIC_WA_NUMBER || '201040101056'}?text=${encodeURIComponent(`مرحباً، أنا مهتم بمجموعة ${d.nameAr || d.name} وأودّ الاستفسار.`)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-gold"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          تحدث معنا عبر واتساب
        </a>
      </div>
    </section>
  )}
</BaseLayout>
