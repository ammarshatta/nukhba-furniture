---
import AdminLayout from '../../layouts/AdminLayout.astro';
// TODO: reconnect to new admin flow

const settings = { waNumber: '', siteTitleAr: '', siteTitleEn: '' };

let saved = false;
let error = '';
---

<AdminLayout title="Settings" subtitle="Global store configuration">
  {saved && <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:6px;padding:12px 16px;margin-bottom:20px;color:#166534;font-size:.88rem;">✅ Settings saved</div>}
  {error && <div style="background:#fdf0f0;border:1px solid #f5c6c6;border-radius:6px;padding:12px 16px;margin-bottom:20px;color:#a33;font-size:.88rem;">Error: {error}</div>}

  <div class="a-card">
    <form method="POST">
      <div class="form-group">
        <label class="form-label">WhatsApp Number (global default)</label>
        <input class="form-input" name="waNumber" value={settings.waNumber} placeholder="201040101056" />
        <small style="color:var(--muted);font-size:.75rem;">International format without + or spaces, e.g. 201040101056</small>
      </div>
      <div class="form-group" style="margin-top:16px;">
        <label class="form-label">Site Title (Arabic)</label>
        <input class="form-input" name="siteTitleAr" value={settings.siteTitleAr} placeholder="شطا للأثاث الفاخر" />
      </div>
      <div class="form-group" style="margin-top:16px;">
        <label class="form-label">Site Title (English)</label>
        <input class="form-input" name="siteTitleEn" value={settings.siteTitleEn} placeholder="Shatta Luxury Furniture" />
      </div>
      <button type="submit" class="btn-primary" style="margin-top:24px;">Save Settings</button>
    </form>
  </div>
</AdminLayout>
