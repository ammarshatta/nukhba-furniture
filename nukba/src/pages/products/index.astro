---
export const prerender = true;

import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductGrid from '../../components/product/ProductGrid.astro';

const allProducts = await getCollection('products', p => p.data.active);

const products = allProducts.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://nukhba.com';

const breadcrumbs = [
  { name: 'Home', url: `${siteUrl}/` },
  { name: 'Products', url: `${siteUrl}/products` },
];
---

<BaseLayout
  title="All Products — Premium Furniture | Nukhba"
  description="Explore Nukhba's full collection of luxury furniture. Handcrafted bedroom, living room, dining room, and office pieces for Egyptian homes."
  currentPath="/products"
  lang="en"
  ogType="website"
  breadcrumbs={breadcrumbs}
>
  <!-- Page header -->
  <section
    class="py-16 lg:py-20"
    style="background-color:var(--color-beige);"
  >
    <div class="max-w-7xl mx-auto px-6 lg:px-12 text-center">
      <span class="section-eyebrow">The Collection</span>
      <h1 class="section-title">Our Furniture Collection</h1>
      <p class="section-subtitle" style="margin-inline:auto; text-align:center;">
        Each piece is crafted with intention — where enduring materials meet refined design for homes that deserve the extraordinary.
      </p>
    </div>
  </section>

  <!-- Products grid -->
  <section class="py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <ProductGrid products={products} lang="en" showFilter={true} />
    </div>
  </section>
</BaseLayout>
