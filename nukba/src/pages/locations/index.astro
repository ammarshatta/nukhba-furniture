---
export const prerender = true;
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allLocations = await getCollection('locations');

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Locations', url: '/locations' },
];

function formatHours(hours: string): string {
  return hours
    .replace('Mo-Th', 'Mon–Thu')
    .replace('Sa-Su', 'Sat–Sun')
    .replace('Mo-Su', 'Mon–Sun');
}
---

<BaseLayout
  title="Our Showrooms | Nukhba Luxury Furniture"
  description="Visit a Nukhba showroom in Cairo or Giza to experience our full luxury furniture collection in person. Expert design consultants on hand every day."
  currentPath="/locations"
  lang="en"
  breadcrumbs={breadcrumbs}
>

  <!-- ── Hero ─────────────────────────────────────────────── -->
  <section class="relative bg-walnut overflow-hidden" style="padding: 120px 8% 100px;">
    <div
      aria-hidden="true"
      class="absolute inset-0 opacity-10"
      style="background: radial-gradient(ellipse 80% 60% at 50% 0%, var(--color-gold), transparent);"
    ></div>
    <div class="relative max-w-4xl mx-auto text-center">
      <span class="section-eyebrow" style="color:var(--color-gold);">In-Person Experience</span>
      <h1 class="section-title" style="color:#fff; font-size:clamp(2.5rem,5vw,4rem);">
        Visit Our Showrooms
      </h1>
      <p class="section-subtitle mt-4 mx-auto" style="color:rgba(255,255,255,0.7); max-width:560px;">
        Nothing replaces the experience of sitting on a sofa, running your hand along a walnut surface, or seeing how a piece catches the light. Come discover Nukhba in person.
      </p>
    </div>
  </section>

  <!-- ── Breadcrumb ─────────────────────────────────────── -->
  <nav aria-label="Breadcrumb" class="bg-beige border-b border-beige-dark">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-3">
      <ol class="flex items-center gap-2 text-sm" style="color:var(--color-warm-gray);">
        <li><a href="/" class="hover:text-gold transition-colors">Home</a></li>
        <li aria-hidden="true" class="opacity-40">/</li>
        <li style="color:var(--color-walnut); font-weight:500;">Locations</li>
      </ol>
    </div>
  </nav>

  <!-- ── Locations Grid ─────────────────────────────────── -->
  <section class="bg-cream" style="padding: 96px 8%;">
    <div class="max-w-7xl mx-auto">

      <div class="text-center mb-16" data-reveal>
        <span class="section-eyebrow">Cairo & Giza</span>
        <h2 class="section-title">{allLocations.length} Showrooms Across Egypt</h2>
        <p class="section-subtitle mx-auto mt-4">
          Each Nukhba showroom is a curated space showcasing our full furniture collections across bedroom, living, dining, and home office categories.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
        {allLocations.map((loc, i) => (
          <article
            class="card overflow-hidden group"
            data-reveal
            style={`transition-delay:${i * 0.1}s;`}
          >
            <!-- Image -->
            <div
              class="overflow-hidden relative"
              style="aspect-ratio:16/9; background:var(--color-beige-dark);"
            >
              {loc.data.image ? (
                <img
                  src={loc.data.image}
                  alt={`${loc.data.name} — exterior and interior`}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  width="640"
                  height="360"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center" style="background:var(--color-beige-dark);">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--color-gold)" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
                  </svg>
                </div>
              )}
              <div
                class="absolute inset-0 transition-opacity duration-300"
                style="background:linear-gradient(to top, rgba(61,43,31,.6) 0%, transparent 50%); opacity:0.6;"
                aria-hidden="true"
              ></div>
              <div class="absolute bottom-0 left-0 p-5">
                <span
                  class="inline-block px-3 py-1 rounded-full text-xs font-semibold"
                  style="background:var(--color-gold); color:var(--color-walnut-dark); letter-spacing:0.08em; text-transform:uppercase;"
                >
                  {loc.data.city}
                </span>
              </div>
            </div>

            <!-- Content -->
            <div class="p-8">
              <h3 style="font-family:var(--font-serif); font-size:1.35rem; color:var(--color-walnut); margin-bottom:.25rem;">
                {loc.data.name}
              </h3>
              <p style="font-size:0.8rem; color:var(--color-gold); letter-spacing:0.1em; text-transform:uppercase; font-weight:500; margin-bottom:1.5rem;">
                {loc.data.area}
              </p>

              <dl class="space-y-3 mb-6">
                <div class="flex items-start gap-3">
                  <svg class="shrink-0 mt-0.5" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
                  </svg>
                  <span style="font-size:0.9rem; color:var(--color-warm-gray); line-height:1.5;">{loc.data.address}</span>
                </div>
                <div class="flex items-start gap-3">
                  <svg class="shrink-0 mt-0.5" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                  </svg>
                  <span style="font-size:0.9rem; color:var(--color-warm-gray);">{formatHours(loc.data.hours)}</span>
                </div>
                <div class="flex items-start gap-3">
                  <svg class="shrink-0 mt-0.5" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.39 2 2 0 0 1 3.6 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 8.91a16 16 0 0 0 6 6l.77-.77a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                  </svg>
                  <a href={`tel:+${loc.data.phone}`} style="font-size:0.9rem; color:var(--color-walnut); font-weight:500;">
                    +{loc.data.phone}
                  </a>
                </div>
              </dl>

              <div class="flex gap-3 flex-wrap">
                <a
                  href={loc.data.googleMapsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-gold"
                  style="font-size:0.8rem; padding:0.625rem 1.25rem;"
                >
                  Get Directions
                </a>
                <a
                  href={`/locations/${loc.data.slug}`}
                  class="btn-outline"
                  style="color:var(--color-walnut); font-size:0.8rem; padding:0.625rem 1.25rem;"
                >
                  View Details
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Book a Visit CTA ───────────────────────────────── -->
  <section class="bg-green" style="padding: 80px 8%;">
    <div class="max-w-3xl mx-auto text-center" data-reveal>
      <span class="section-eyebrow" style="color:var(--color-gold);">Plan Your Visit</span>
      <h2 style="font-family:var(--font-serif); font-size:clamp(1.8rem,3vw,2.5rem); color:#fff; margin-bottom:1rem;">
        Book a Private Consultation
      </h2>
      <p style="color:rgba(255,255,255,0.7); font-size:1rem; line-height:1.7; margin-bottom:2rem;">
        Message us on WhatsApp to schedule a private showroom appointment with one of our design consultants — no queues, just dedicated attention to your space.
      </p>
      <a
        href={`https://wa.me/${import.meta.env.PUBLIC_WA_NUMBER || '201234567890'}?text=${encodeURIComponent('Hello, I would like to book a showroom appointment.')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 rounded-lg font-semibold transition-all"
        style="background:#25D366; color:#fff; padding:0.875rem 2rem; font-size:0.95rem; box-shadow:0 4px 20px rgba(37,211,102,.35);"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
          <path d="M12 0C5.373 0 0 5.373 0 12c0 2.117.549 4.104 1.51 5.829L0 24l6.335-1.485A11.945 11.945 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 0 1-5.007-1.374l-.36-.214-3.722.873.936-3.612-.235-.373A9.818 9.818 0 1 1 12 21.818z"/>
        </svg>
        Book via WhatsApp
      </a>
    </div>
  </section>

</BaseLayout>
