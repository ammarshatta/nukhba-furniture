---
export const prerender = true;

import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingBody from '../components/landing/LandingBody.astro';
import { resolveLandingProducts, isLandingIndexable } from '../lib/landings';

export async function getStaticPaths() {
  const landings = await getCollection('landings');
  return landings.map(landing => ({
    params: { landing: landing.data.slug },
    props: { landing },
  }));
}

interface Props {
  landing: CollectionEntry<'landings'>;
}

const { landing } = Astro.props;
const d = landing.data;

const allProducts = await getCollection('products');
const products = resolveLandingProducts(landing, allProducts);
const indexable = isLandingIndexable(landing, allProducts);

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://shattafurniture.com';
const breadcrumbs = [
  { name: 'الرئيسية', url: `${siteUrl}/` },
  { name: d.h1Ar, url: `${siteUrl}/${d.slug}` },
];
// FAQ JSON-LD uses the Arabic strings on the Arabic page.
const faqs = d.faqs.map(f => ({ question: f.questionAr, answer: f.answerAr }));
---

<BaseLayout
  title={d.titleAr}
  description={d.metaDescriptionAr}
  currentPath={`/${d.slug}`}
  alternateUrl={`/en/${d.slug}`}
  lang="ar"
  ogType="website"
  ogImage={d.heroImage}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
  noindex={!indexable}
>
  <LandingBody landing={landing} products={products} lang="ar" />
</BaseLayout>
