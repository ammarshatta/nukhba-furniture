---
// Server-rendered so we can detect the language from the requested URL.
export const prerender = false;
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// Astro automatically renders this route for any unmatched path.
// Detect language from the requested path: English lives under /en.
const isAr = !Astro.url.pathname.startsWith('/en');
const lang = isAr ? 'ar' : 'en';
const dir = isAr ? 'rtl' : 'ltr';

const waNumber = import.meta.env.PUBLIC_WA_NUMBER || '201040101056';

const allProducts = await getCollection('products', p => p.data.active);

// Prefer featured pieces; fall back to the newest if there aren't enough.
const featuredProducts = allProducts
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured))
  .slice(0, 4);

const t = {
  code: '404',
  eyebrow: isAr ? 'الصفحة غير موجودة' : 'Page Not Found',
  heading: isAr ? 'عذراً، لم نجد هذه الصفحة' : 'Sorry, we couldn’t find that page',
  body: isAr
    ? 'ربما تم نقل الصفحة أو حذفها، أو أن الرابط غير صحيح. تصفّح أحدث قطعنا أو عُد إلى الصفحة الرئيسية.'
    : 'The page may have moved or been removed, or the link might be incorrect. Browse our latest pieces or head back home.',
  home: isAr ? 'العودة للرئيسية' : 'Back to Home',
  shop: isAr ? 'تصفّح المنتجات' : 'Browse Products',
  featuredEyebrow: isAr ? 'قد يعجبك أيضاً' : 'You Might Also Like',
  featuredHeading: isAr ? 'قطع مختارة' : 'Featured Pieces',
  viewDetails: isAr ? 'عرض التفاصيل' : 'View Details',
};

const homeHref = isAr ? '/' : '/en';
const shopHref = isAr ? '/products' : '/en/products';
---

<BaseLayout
  title={isAr ? 'الصفحة غير موجودة (404) | شطا' : 'Page Not Found (404) | Shatta'}
  description={t.body}
  currentPath={Astro.url.pathname}
  lang={lang}
  noindex={true}
>
  <!-- ── Hero ─────────────────────────────────────────────── -->
  <section class="relative bg-walnut overflow-hidden" style="padding: 120px 8% 90px;" dir={dir}>
    <div
      aria-hidden="true"
      class="absolute inset-0 opacity-10"
      style="background: radial-gradient(ellipse 80% 60% at 50% 0%, var(--color-gold), transparent);"
    ></div>
    <div class="relative max-w-3xl mx-auto text-center">
      <span
        style="font-family:var(--font-serif); font-size:clamp(5rem,16vw,9rem); font-weight:700; line-height:1; color:var(--color-gold); display:block; letter-spacing:0.05em;"
      >
        {t.code}
      </span>
      <span class="section-eyebrow" style="color:var(--color-gold);">{t.eyebrow}</span>
      <h1 class="section-title" style="color:#fff; font-size:clamp(2rem,4.5vw,3.25rem);">
        {t.heading}
      </h1>
      <p class="section-subtitle mt-4 mx-auto" style="color:rgba(255,255,255,0.7); max-width:520px;">
        {t.body}
      </p>
      <div class="flex flex-wrap gap-4 justify-center mt-8">
        <a href={homeHref} class="btn-primary">{t.home}</a>
        <a href={shopHref} class="btn-outline" style="color:#fff; border-color:rgba(255,255,255,0.4);">
          {t.shop}
        </a>
      </div>
    </div>
  </section>

  <!-- ── Featured products ────────────────────────────────── -->
  {featuredProducts.length > 0 && (
    <section class="py-20 lg:py-28" dir={dir} style="background-color: var(--color-beige);" data-reveal>
      <div class="max-w-7xl mx-auto px-6 lg:px-12">
        <div class="text-center mb-12">
          <span class="section-eyebrow">{t.featuredEyebrow}</span>
          <h2 class="section-title">{t.featuredHeading}</h2>
        </div>

        <div class="products-grid">
          {featuredProducts.map((product, i) => {
            const name = isAr ? product.data.titleAr : product.data.title;
            const href = isAr ? `/products/${product.data.slug}` : `/en/products/${product.data.slug}`;
            const image = product.data.images?.[0];
            return (
              <div class="card product-card flex-shrink-0" data-reveal style={`animation-delay: ${i * 0.06}s;`}>
                <div class="relative overflow-hidden" style="aspect-ratio: 4/3;">
                  {image ? (
                    <img
                      src={image}
                      alt={name}
                      loading="lazy"
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center" style="background: var(--color-beige-dark);">
                      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" style="color: var(--color-warm-gray);" aria-hidden="true">
                        <rect x="3" y="3" width="18" height="18" rx="2"/>
                        <circle cx="8.5" cy="8.5" r="1.5"/>
                        <polyline points="21 15 16 10 5 21"/>
                      </svg>
                    </div>
                  )}
                </div>
                <div class="p-5">
                  <h3 class="font-serif mb-1 leading-snug" style="font-size: 1.05rem; font-weight: 600; color: var(--color-walnut);">
                    {name}
                  </h3>
                  <p class="text-sm mb-4" style="color: var(--color-gold); font-weight: 600; font-size: 1rem;">
                    {product.data.price}
                  </p>
                  <a href={href} class="btn-primary text-center justify-center w-full" style="padding: 0.6rem 1rem; font-size: 0.75rem;">
                    {t.viewDetails}
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .products-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  @media (max-width: 1024px) {
    .products-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .products-grid { grid-template-columns: 1fr; }
  }
</style>
