---
export const prerender = true;

import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogGrid from '../../components/blog/BlogGrid.astro';

const allPosts = await getCollection('blog');

const posts = allPosts.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://shattafurniture.com';

const breadcrumbs = [
  { name: 'الرئيسية', url: `${siteUrl}/` },
  { name: 'المدونة', url: `${siteUrl}/blog` },
];
---

<BaseLayout
  title="مدونة الأثاث | شطا"
  description="أدلة متخصصة وأحدث الاتجاهات ورؤى حول المواد من محرري شطا. كل ما تحتاج معرفته لاختيار الأثاث الفاخر والعناية به."
  currentPath="/blog"
  alternateUrl="/en/blog"
  lang="ar"
  ogType="website"
  breadcrumbs={breadcrumbs}
>
  {/* ── Hero header ── */}
  <section
    class="py-20 lg:py-28 text-center"
    style="background-color:var(--color-walnut);"
    data-reveal
  >
    <div class="max-w-3xl mx-auto px-6 lg:px-12">
      <span
        class="section-eyebrow"
        style="color:var(--color-gold); margin-bottom:1rem; display:inline-block;"
      >
        معرفة وإلهام
      </span>
      <h1
        class="section-title"
        style="color:var(--color-cream); font-size:clamp(2.25rem, 5vw, 4rem); margin-bottom:1.25rem;"
      >
        مجلة الأثاث
      </h1>
      <p
        class="section-subtitle mx-auto"
        style="color:rgba(250,250,247,0.7); max-width:560px; text-align:center;"
      >
        أدلة متخصصة وتحليل للخامات وأحدث اتجاهات التصميم — كل ما تحتاجه لاتخاذ قرارات واثقة في اختيار أثاث منزلك.
      </p>
    </div>
  </section>

  {/* ── Blog grid ── */}
  <section class="py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <BlogGrid posts={posts} lang="ar" showFilter={true} />
    </div>
  </section>
</BaseLayout>
