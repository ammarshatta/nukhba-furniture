---
import PublicLayout from '../../../layouts/PublicLayout.astro';
import ProductCard from '../../../components/product/ProductCard.astro';
import { getCategoryBySlug, getProducts, getCategories } from '../../../lib/storyblok';
import { getSettings } from '../../../lib/data';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/en');

const [cat, products, categories, settings] = await Promise.all([
  getCategoryBySlug(slug),
  getProducts(),
  getCategories(),
  getSettings(),
]);

if (!cat) return Astro.redirect('/en');

const lang = 'en' as const;
const baseUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://nukba.com';
const refToken = Astro.url.searchParams.get('ref') ?? Astro.cookies.get('nukba_ref')?.value ?? undefined;
const catProducts = products.filter(p => p.active && p.category === slug);
---

<PublicLayout
  lang={lang}
  title={cat.nameEn}
  description={`Browse our premium ${cat.nameEn} collection from Nukba — ${catProducts.length} products available`}
  canonical={`${baseUrl}/en/category/${slug}`}
  alternateUrl={`${baseUrl}/category/${slug}`}
  settings={settings}
  categories={categories}
  breadcrumbs={[
    { name: 'Home', url: `${baseUrl}/en` },
    { name: cat.nameEn, url: `${baseUrl}/en/category/${slug}` },
  ]}
>
  <div class="cat-page">
    <div class="cat-page-head" data-r>
      <div class="s-eyebrow">{cat.nameEn}</div>
      <h1 class="s-heading">{cat.nameEn}</h1>
      <p class="s-sub">
        {catProducts.length === 0
          ? 'No products in this category yet'
          : `${catProducts.length} products available`}
      </p>
    </div>

    <div class="pgrid">
      {catProducts.map(product => (
        <ProductCard product={product} lang={lang} globalWaNumber={settings.waNumber} refToken={refToken} />
      ))}
    </div>

    {catProducts.length === 0 && (
      <p style="text-align:center;color:var(--muted);padding:60px 0;">No products in this category yet</p>
    )}
  </div>
</PublicLayout>
