---
import PublicLayout from '../../layouts/PublicLayout.astro';
import Hero from '../../components/home/Hero.astro';
import Marquee from '../../components/home/Marquee.astro';
import CategoryGrid from '../../components/home/CategoryGrid.astro';
import ProductGrid from '../../components/home/ProductGrid.astro';
import VideoSection from '../../components/home/VideoSection.astro';
import Testimonials from '../../components/home/Testimonials.astro';
import WhatsAppCTA from '../../components/product/WhatsAppCTA.astro';
import { getProducts, getCategories } from '../../lib/storyblok';
import { getSettings } from '../../lib/data';

const [products, categories, settings] = await Promise.all([
  getProducts(),
  getCategories(),
  getSettings(),
]);

const lang = 'en' as const;
const baseUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://nukba.com';
const refToken = Astro.url.searchParams.get('ref') ?? undefined;
---

<PublicLayout
  lang={lang}
  title="Luxury Furniture — Bedrooms, Living Rooms & Dining"
  description="Nukba Luxury Furniture — premium collection of bedrooms, living rooms, dining sets and kitchens. Unmatched quality with free delivery."
  canonical={`${baseUrl}/en`}
  alternateUrl={`${baseUrl}/`}
  settings={settings}
  categories={categories}
>
  <Hero lang={lang} settings={settings} />
  <Marquee lang={lang} />
  <CategoryGrid lang={lang} categories={categories} products={products} />
  <ProductGrid lang={lang} products={products} categories={categories} globalWaNumber={settings.waNumber} refToken={refToken} />
  <VideoSection lang={lang} />
  <Testimonials lang={lang} />

  <section class="cta-strip">
    <h2 class="s-heading">Ready to Transform Your Space?</h2>
    <p class="s-sub">Chat with our advisor now and design your perfect furniture</p>
    <WhatsAppCTA
      waNumber={settings.waNumber}
      messageAr="مرحباً، أريد الاستفسار عن تصميم أثاث مخصص"
      messageEn="Hello, I would like to inquire about custom furniture design"
      lang={lang}
      refToken={refToken}
      variant="strip"
    />
  </section>
</PublicLayout>
